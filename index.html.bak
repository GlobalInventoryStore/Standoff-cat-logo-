    <!-- Modal Como Funcionamos -->
    <div id="modal-como-funcionamos" class="modal-backdrop hidden items-center justify-center z-[99999] p-3 sm:p-6 animate-fade-in">
        <div class="bg-[#16130e] border border-[#2b251c] rounded-[20px] p-4 sm:p-6 relative shadow-2xl max-w-full max-h-[88dvh] overflow-y-auto">
            <button type="button" onclick="closeModalComoFunciona()" class="absolute top-4 right-4 min-w-[40px] min-h-[40px] flex items-center justify-center text-[#f59e0b] hover:text-white text-lg font-bold cursor-pointer" aria-label="Fechar">✕</button>
            <h2 class="text-2xl font-bold text-[#f59e0b] mb-6 text-center">Como Atuamos</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-[#1c1812] rounded-xl p-5 border border-[#2b251c]">
                    <div class="w-11 h-11 rounded-xl bg-[#f59e0b]/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-[#f59e0b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 4v5c0 5.25-3.4 9.74-8 11-4.6-1.26-8-5.75-8-11V7l8-4z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-[#f59e0b] mb-2">Intermediação e Custódia</h3>
                    <p class="text-[#b3b3b3] text-sm leading-relaxed">O MARKTPLACE stand2 é uma plataforma independente de intermediação e não possui vínculo oficial, patrocínio ou afiliação com a Axlebolt nem com o Standoff 2. Todos os pagamentos ficam em custódia com o suporte intermediário. Isso garante segurança para ambas as partes, assegurando que a liberação dos dados da conta só ocorra após a confirmação do pagamento e mediante registro de ticket de rastreio. Não há chat direto entre comprador e vendedor (evitando acordos por fora ou golpes).</p>
                </div>
                <div class="bg-[#1c1812] rounded-xl p-5 border border-[#2b251c]">
                    <div class="w-11 h-11 rounded-xl bg-[#f59e0b]/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-[#f59e0b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-[#f59e0b] mb-2">Conferência da Conta</h3>
                    <p class="text-[#b3b3b3] text-sm leading-relaxed">Antes da liberação, nossa equipe confere a conta verificando: status do jogo, itens reivindicados e autenticidade do anúncio. Isso previne fraudes e garante que você receba o que foi combinado.</p>
                </div>
                <div class="bg-[#1c1812] rounded-xl p-5 border border-[#2b251c]">
                    <div class="w-11 h-11 rounded-xl bg-[#f59e0b]/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-[#f59e0b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-[#f59e0b] mb-2">Atendimento Centralizado</h3>
                    <p class="text-[#b3b3b3] text-sm leading-relaxed">Não há chat direto entre comprador e vendedor. Todas as comunicações passam pelo suporte do MARKTPLACE stand2, garantindo privacidade e proteção jurídica conforme os Termos de Serviço.</p>
                </div>
                <div class="bg-[#1c1812] rounded-xl p-5 border border-[#2b251c]">
                    <div class="w-11 h-11 rounded-xl bg-[#f59e0b]/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-[#f59e0b]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-[#f59e0b] mb-2">Benefícios Rápidos</h3>
                    <p class="text-[#b3b3b3] text-sm leading-relaxed">Para comprador: conta entregue em custódia rápida. Para vendedor: repasse liberado após confirmação. Processo simplificado sem complicações desnecessárias.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        let currentUser = null;
        let codigoEnviadoSimulado = "";
        let codigoAnuncioSimulado = "";
        let anunciosEmMemoria = [];
        let carrinhoItens = [];
        let pedidosAtivos = [];
        let anuncioSelecionadoAtual = null;
        let fotosNovasBase64 = [];

        // ===== Admin e EmailJS (preencha as credenciais abaixo) =====
        const ADMIN_EMAIL = "scruzsamuka@gmail.com";
        const ADMIN_EMAIL_EXTRA = "globalinventorystore@gmail.com";
        const ADMIN_EMAILS = [ADMIN_EMAIL, ADMIN_EMAIL_EXTRA];
        function ehEmailAdmin(email) {
            const alvo = (email || "").toLowerCase();
            return ADMIN_EMAILS.some(adm => adm === alvo);
        }
        const APP_CONFIG = window.CONFIG || {};
        const ADMIN_SENHA_DIRETA = APP_CONFIG.ADMIN_SENHA_DIRETA || "";
        const CODIGO_ADMIN_FIXO = APP_CONFIG.CODIGO_ADMIN_FIXO || "";
        const CHAVE_STORAGE_BANIDOS = "marktplace_stand2_banidos";
        const EMAILJS_SERVICE_ID = APP_CONFIG.EMAILJS_SERVICE_ID || "service_cbzumvf";
        const EMAILJS_TEMPLATE_ID = APP_CONFIG.EMAILJS_TEMPLATE_ID || "template_2i8efoy";
        const EMAILJS_PUBLIC_KEY = APP_CONFIG.EMAILJS_PUBLIC_KEY || "1vj4x8Vvg6VTECZG7";
        let emailjsInicializado = false;

        // ===== Alerta WhatsApp do admin (chat de suporte) =====
        const ADMIN_WHATSAPP = APP_CONFIG.ADMIN_WHATSAPP || "5564984156811";
        const WHATSAPP_ALERTA_COOLDOWN_MS = 60000;
        const CHAVE_STORAGE_WPP_COOLDOWN = "marktplace_stand2_wpp_alertas";

        const STATUS_PEDIDO = {
            aguardando_pagamento: 'Aguardando confirmação do pagamento',
            aguardando_conta_vendedor: 'Pagamento confirmado - aguardando envio dos dados da conta',
            em_conferencia: 'Dados recebidos - suporte conferindo a conta antes da entrega',
            entregue_finalizado: 'Conta entregue e confirmada - repasse liberado'
        };

        function montarResumoRapidoTicket({ ticketId, statusKey, itensResumo, compradorEmail, compradorWhats }) {
            const statusTexto = STATUS_PEDIDO[statusKey] || STATUS_PEDIDO.aguardando_pagamento;
            return `
🎫 <strong>Ticket:</strong> ${escapeHtml(ticketId)}
📌 <strong>Status atual:</strong> ${statusTexto}
🛒 <strong>Itens:</strong> ${itensResumo}
👤 <strong>Comprador:</strong> ${compradorEmail} | ${compradorWhats}

⚡ <strong>Como funciona a entrega rápida:</strong>
1. Pagamento validado fica em custódia com o suporte.
2. Solicitamos os dados da conta ao vendedor e conferimos o anúncio.
3. Liberamos os dados aqui no suporte e, após sua confirmação, o repasse ao vendedor é concluído.
            `.trim();
        }

        function gerarSvgAvatar(newShape, detalhe) {
            return `data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='#16130e'/><rect x='2.5' y='2.5' width='59' height='59' rx='12' fill='none' stroke='#2b251c' stroke-width='2'/>${newShape}${detalhe}</svg>`)}`;
        }

        const AVATARES = [
            gerarSvgAvatar("<path d='M32 12c-9 0-16 7-16 16v10c0 9 7 16 16 16s16-7 16-16V28c0-9-7-16-16-16z' fill='#1c1812' stroke='#0b0907' stroke-width='1.5'/><path d='M22 30h20v8a4 4 0 0 1-4 4H26a4 4 0 0 1-4-4z' fill='#0b0907'/><rect x='25' y='33' width='14' height='3.5' rx='1.75' fill='#f59e0b'/>", "<text x='32' y='12' font-size='6' text-anchor='middle' fill='#ffffff' font-family='monospace'>GHOST</text>"),
            gerarSvgAvatar("<circle cx='32' cy='30' r='17' fill='#1c1812' stroke='#0b0907' stroke-width='1.5'/><path d='M21 32h22v7a6 6 0 0 1-6 6H27a6 6 0 0 1-6-6z' fill='#0b0907'/><rect x='25' y='35' width='5' height='3' rx='1.5' fill='#f59e0b'/><rect x='34' y='35' width='5' height='3' rx='1.5' fill='#f59e0b'/>", "<rect x='30' y='13' width='4' height='10' rx='2' fill='#ffffff' opacity='0.85'/>"),
            gerarSvgAvatar("<path d='M32 13c-10 0-18 8-18 18v9c0 10 8 18 18 18s18-8 18-18v-9c0-10-8-18-18-18z' fill='#1c1812' stroke='#0b0907' stroke-width='1.5'/><circle cx='32' cy='34' r='9' fill='#0b0907'/><circle cx='32' cy='34' r='4' fill='none' stroke='#f59e0b' stroke-width='2'/><path d='M32 22v-6' stroke='#f59e0b' stroke-width='2'/>", "<text x='32' y='12' font-size='6' text-anchor='middle' fill='#ffffff' font-family='monospace'>SNIPER</text>"),
            gerarSvgAvatar("<path d='M32 12c-10 0-18 8-18 18v8c0 10 8 18 18 18s18-8 18-18v-8c0-10-8-18-18-18z' fill='#1c1812' stroke='#0b0907' stroke-width='1.5'/><path d='M18 34c0-4 6-6 14-6s14 2 14 6v4H18z' fill='#0b0907'/><rect x='23' y='34' width='18' height='2.5' rx='1.25' fill='#f59e0b'/>", "<path d='M14 20c6-6 12-7 18-7s12 1 18 7' stroke='#ffffff' stroke-width='2' fill='none' opacity='0.85'/>"),
            gerarSvgAvatar("<path d='M32 12c-10 0-18 8-18 18v10c0 9 8 17 18 17s18-8 18-17V30c0-10-8-18-18-18z' fill='#1c1812' stroke='#0b0907' stroke-width='1.5'/><path d='M20 33h24v6a5 5 0 0 1-5 5H25a5 5 0 0 1-5-5z' fill='#0b0907'/><rect x='24' y='35' width='7' height='3' rx='1.5' fill='#f59e0b'/><rect x='35' y='35' width='5' height='3' rx='1.5' fill='#ffffff'/>", "<rect x='28' y='10' width='8' height='6' rx='2' fill='#f59e0b' opacity='0.9'/>")
        ];

        function escapeHtml(str) {
            return String(str ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function sanitizarNomePublico(nome) {
            if (!nome) return "Jogador";
            if (nome.includes("@")) return nome.split("@")[0];
            return nome;
        }

        function ehIdNumerico(id) {
            return (typeof id === "number" && Number.isFinite(id)) || (typeof id === "string" && /^\d+$/.test(id.trim()));
        }

        function normalizarAnuncio(row) {
            const curtidoFlag = Boolean(row.curtidoPormim ?? row.curtidoPorMim ?? false);
            const fotosNormalizadas = Array.isArray(row.fotos) ? row.fotos : [];
            const textoDesc = row.descricao ?? row.desc ?? "• Inventário verificado e garantido.";
            const rawId = row.id ?? ("local_" + Date.now());
            return {
                id: ehIdNumerico(rawId) ? Number(rawId) : String(rawId),
                titulo: row.titulo || "Conta Standoff 2",
                preco: row.preco || "R$ 0,00",
                rank: row.rank || "Master",
                vinculo: row.vinculo || "Google ID",
                descricao: textoDesc,
                desc: textoDesc,
                vendedor: row.vendedor || "Sistema",
                likes: Number(row.likes ?? 0),
                curtidoPormim: curtidoFlag,
                fotos: fotosNormalizadas
            };
        }

        function prepararPayloadSupabase(anuncio, incluirId = false) {
            const textoDescricao = anuncio.descricao ?? anuncio.desc ?? "• Inventário verificado e garantido.";
            const payload = {
                titulo: anuncio.titulo,
                preco: anuncio.preco,
                rank: anuncio.rank,
                vinculo: anuncio.vinculo,
                descricao: textoDescricao,
                vendedor: anuncio.vendedor,
                likes: Number(anuncio.likes ?? 0),
                curtidoPormim: Boolean(anuncio.curtidoPormim),
                fotos: Array.isArray(anuncio.fotos) ? anuncio.fotos : []
            };
            if (incluirId && ehIdNumerico(anuncio.id)) {
                payload.id = Number(anuncio.id);
            }
            return payload;
        }

        function carregarEstadoLocalSeguro() {
            const termosAceitos = localStorage.getItem("marktplace_stand2_termos");
            if (!termosAceitos) {
                const modalBoasVindas = document.getElementById("modal-boas-vindas");
                if (modalBoasVindas) modalBoasVindas.style.display = "flex";
            }
            const storedUser = localStorage.getItem("marktplace_stand2_user");
            if (storedUser) {
                try {
                    currentUser = JSON.parse(storedUser);
                    if (currentUser) {
                        currentUser.username = sanitizarNomePublico(currentUser.username);
                        currentUser.isAdmin = Boolean(currentUser.email && ehEmailAdmin(currentUser.email));
                        aplicarEstadoUsuario();
                    }
                } catch (e) {
                    localStorage.removeItem("marktplace_stand2_user");
                }
            }
            const storedCart = localStorage.getItem("marktplace_stand2_cart");
            if (storedCart) {
                try {
                    carrinhoItens = JSON.parse(storedCart) || [];
                } catch (e) {
                    carrinhoItens = [];
                }
                atualizarBadgeCarrinho();
            }
            const storedPedidos = localStorage.getItem("marktplace_stand2_pedidos");
            if (storedPedidos) {
                try {
                    pedidosAtivos = JSON.parse(storedPedidos) || [];
                } catch (e) {
                    pedidosAtivos = [];
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Menu hambúrguer: wiring independente — falha em qualquer inicialização abaixo não pode deixar o botão morto
            try {
                const hamburgerBtn = document.getElementById("hamburger-btn");
                const mobileMenu = document.getElementById("mobile-menu");
                if (hamburgerBtn && mobileMenu) {
                    hamburgerBtn.addEventListener("click", function(e) {
                        e.stopPropagation();
                        const abrir = mobileMenu.classList.contains("hidden");
                        mobileMenu.classList.toggle("hidden", !abrir);
                        mobileMenu.classList.toggle("menu-aberto", abrir);
                        hamburgerBtn.setAttribute("aria-expanded", abrir ? "true" : "false");
                    });
                    document.addEventListener("click", function(e) {
                        if (!mobileMenu.contains(e.target) && !hamburgerBtn.contains(e.target)) {
                            fecharMenuMobile();
                        }
                    });
                    mobileMenu.querySelectorAll(".menu-link").forEach(link => {
                        link.addEventListener("click", function() {
                            fecharMenuMobile();
                        });
                    });
                }
            } catch (err) {
                console.warn("Falha ao inicializar o menu hambúrguer:", err);
            }

            [carregarEstadoLocalSeguro, carregarAvataresRegistro, carregarCatalogo, inicializarAnuncios, sincronizarBanidosSupabase].forEach(function(fn) {
                try { fn(); } catch (err) { console.warn("Falha na inicialização:", fn && fn.name, err); }
            });
        });

        function concordarTermosEntrada() {
            localStorage.setItem("marktplace_stand2_termos", "true");
            document.getElementById("modal-boas-vindas").style.display = "none";
        }

        function mostrarAlerta(titulo, texto, tipo = "sucesso") {
            document.getElementById("alerta-titulo").textContent = titulo;
            document.getElementById("alerta-texto").textContent = texto;
            const icone = document.getElementById("alerta-icone");
            if (tipo === "sucesso") {
                icone.className = "alerta-icone-ok";
                icone.textContent = "✓";
            } else {
                icone.className = "alerta-icone-aviso";
                icone.textContent = "!";
            }
            document.getElementById("modal-alerta").style.display = "flex";
        }

        function fecharAlerta() {
            document.getElementById("modal-alerta").style.display = "none";
        }

        function carregarAvataresRegistro() {
            const grid = document.getElementById("avatars-grid");
            if (!grid) return;
            grid.innerHTML = "";
            AVATARES.forEach((url) => {
                const img = document.createElement("img");
                img.src = url;
                img.className = "w-10 h-10 rounded-full cursor-pointer border-2 border-transparent hover:border-[var(--accent)] transition p-1 bg-[#050505]";
                img.onclick = function() {
                    document.querySelectorAll("#avatars-grid img").forEach(i => i.classList.remove("border-[var(--accent)]"));
                    img.classList.add("border-[var(--accent)]");
                    document.getElementById("selected-avatar").value = url;
                };
                grid.appendChild(img);
            });
            if (grid.firstChild) grid.firstChild.click();
        }

        function showTab(tab, event) {
            document.querySelectorAll(".tab-content").forEach(el => el.classList.remove("active"));
            document.querySelectorAll(".tab").forEach(el => el.classList.remove("active"));
            document.getElementById(tab + "-tab").classList.add("active");
            if (event && event.currentTarget) event.currentTarget.classList.add("active");
        }

        function openModal() { setModalVisivel("modal", true); fecharMenuMobile(); }
        function closeModal() { setModalVisivel("modal", false); }
        function openTermosModal() { setModalVisivel("modal-termos", true); }
        function closeTermosModal() { setModalVisivel("modal-termos", false); }

        let rastreioAutoRefreshId = null;
        let rastreioBuscaEmAndamento = false;

        function pararAutoRefreshRastreio() {
            if (rastreioAutoRefreshId) { clearInterval(rastreioAutoRefreshId); rastreioAutoRefreshId = null; }
        }
        function abrirRastreioPedido() {
            fecharMenuMobile();
            setModalVisivel("modal-rastreio", true);
            pararAutoRefreshRastreio();
            rastreioAutoRefreshId = setInterval(atualizarRastreioAutomaticamente, 4000);
            if (isAdminUsuario()) {
                const campo = document.getElementById("input-codigo-rastreio");
                if (campo) campo.value = "";
                const resBox = document.getElementById("resultado-rastreio");
                if (resBox) { resBox.classList.remove("hidden"); resBox.innerHTML = '<p class="text-xs text-gray-400">Carregando tickets em aberto do Supabase...</p>'; }
                consultarStatusPedido();
            }
        }
        function closeRastreio() {
            setModalVisivel("modal-rastreio", false);
            pararAutoRefreshRastreio();
            pararCronometroSaidaFila();
        }
        function atualizarRastreioAutomaticamente() {
            const modal = document.getElementById("modal-rastreio");
            if (!modal || modal.style.display === "none") return;
            if (rastreioBuscaEmAndamento) return;
            const codigo = normalizarCodigoTicket(document.getElementById("input-codigo-rastreio").value);
            if (!codigo && !isAdminUsuario()) return;
            consultarStatusPedido(true);
        }

        const ETAPAS_CUSTODIA = [
            "1. Pagamento retido pelo site (custódia segura)",
            "2. Verificação do comprovante de pagamento pelo admin",
            "3. Vendedor entrega os dados da conta ao site",
            "4. Comprador confirma acesso e troca de dados",
            "5. Pagamento liberado ao vendedor (custódia concluída)"
        ];

        function etapaAtualDoPedido(pedido) {
            if (!pedido) return 0;
            if (pedido.etapa) return Math.min(5, Math.max(1, Number(pedido.etapa)));
            if (ticketConcluido(pedido)) return 5;
            return Math.min(5, Math.max(1, (pedido.etapasCustodia || []).length || 1));
        }

        function conteudoPainelIntermediacao(pedido, codigo) {
            const etapaAtual = etapaAtualDoPedido(pedido);
            const etapasHtml = ETAPAS_CUSTODIA.map((etapa, indice) => {
                const numero = indice + 1;
                const concluida = pedido && numero <= etapaAtual;
                const ehAtual = pedido && numero === etapaAtual;
                const classe = concluida ? "text-emerald-400" : "text-gray-500";
                const marcador = ehAtual ? ' <span class="text-[var(--accent)] font-bold">← etapa atual</span>' : (concluida ? " ✓" : "");
                return `<p class="${classe}">${escapeHtml(etapa)}${marcador}</p>`;
            }).join("");
            const info = pedido
                ? `<p class="text-white font-bold">Status: <span class="text-emerald-400">● ${escapeHtml(pedido.status)}</span></p><p class="text-gray-400">Etapa atual: <span class="text-[var(--accent)] font-bold">[${etapaAtual}/5]</span></p><p class="text-gray-400">Itens: ${escapeHtml(pedido.itens)}</p><p class="text-gray-400">Total: <span class="text-white">${escapeHtml(pedido.total)}</span></p><p class="text-[10px] text-gray-500 mt-1">Ticket: <strong>${escapeHtml(pedido.ticketId)}</strong></p>`
                : `<p class="text-white font-bold">Status: <span class="text-amber-400">● Não encontrado nesta sessão</span></p><p class="text-gray-400">Código consultado: ${escapeHtml(codigo)}</p><p class="text-[10px] text-amber-400 mt-1">Amostras antigas de tickets (TICK-4819 etc.) de demonstração não são reais.</p>`;
            const botaoSuporte = `<button type="button" onclick="closeRastreio(); abrirChatSuporte()" class="mt-2 w-full bg-[#1c1812] hover:bg-[#26211a] text-white py-2 rounded-xl text-xs font-bold cursor-pointer border border-[#2f2920]">💬 Falar com o suporte sobre ${escapeHtml(codigo || "o pedido")}</button>`;
            return `${info}<div class="mt-2 border-t border-[#26211a] pt-2"><p class="text-[10px] uppercase font-bold text-[var(--accent)] mb-1">Etapas de custódia</p>${etapasHtml}</div>${botaoSuporte}`;
        }

        async function definirEtapaTicketAdmin(ticketId, etapa) {
            if (!isAdminUsuario()) { mostrarAlerta("Admin", "Apenas a conta admin pode alterar a etapa.", "aviso"); return; }
            const codigo = normalizarCodigoTicket(ticketId);
            const pedido = pedidosAtivos.find(p => normalizarCodigoTicket(p.ticketId) === codigo || normalizarCodigoTicket(p.pedidoId) === codigo);
            if (!pedido) { mostrarAlerta("Admin", `Ticket ${codigo} não encontrado.`, "aviso"); return; }
            const ehConclusao = etapa >= 5;
            const statusTexto = ehConclusao ? "Concluído / Entregue (pagamento liberado ao vendedor)" : ETAPAS_CUSTODIA[etapa - 1];
            pedido.etapa = etapa;
            pedido.concluido = ehConclusao;
            pedido.concluidoEm = ehConclusao ? new Date().toISOString() : null;
            pedido.status = statusTexto;
            pedido.etapasCustodia = ETAPAS_CUSTODIA.slice(0, etapa);
            localStorage.setItem("marktplace_stand2_pedidos", JSON.stringify(pedidosAtivos));
            const okBanco = await atualizarEtapaTicketSupabase(codigo, etapa, statusTexto, ehConclusao);
            if (okBanco) {
                mostrarAlerta("Admin", `Etapa ${etapa}/5 do ticket ${codigo} aplicada no Supabase e localmente.`);
            } else {
                mostrarAlerta("Admin", `Falha ao gravar a etapa ${etapa}/5 do ticket ${codigo} no Supabase. Recarregando os dados reais do banco...`, "aviso");
                const doBanco = await buscarTicketSupabase(codigo);
                if (doBanco) { sincronizarPedidoLocal(converterRegistroSupabase(doBanco)); }
            }
            const codigoAtual = normalizarCodigoTicket(document.getElementById("input-codigo-rastreio").value);
            if (codigoAtual) { await consultarStatusPedido(); }
        }

        function limparTicketsDeTeste() {
            if (!isAdminUsuario()) { mostrarAlerta("Admin", "Apenas a conta admin pode limpar o histórico.", "aviso"); return; }
            if (!confirm(`Limpar TODOS os tickets locais (${pedidosAtivos.length})? Use para zerar tickets de teste no localStorage. Tickets no Supabase não são afetados aqui — para apagar um ticket de verdade, abra o ticket e use "Excluir este ticket (Supabase + local)".`)) return;
            pedidosAtivos = [];
            localStorage.setItem("marktplace_stand2_pedidos", "[]");
            const resBox = document.getElementById("resultado-rastreio");
            if (resBox) { resBox.innerHTML = '<p class="text-emerald-400 text-xs">Histórico local de tickets limpo.</p>'; }
            mostrarAlerta("Admin", "Histórico local de tickets limpo.");
        }

        async function excluirTicketSupabase(codigo) {
            if (!window.supabaseClient || !codigo) return false;
            try {
                const { data, error } = await window.supabaseClient.from("tickets").delete().eq("codigo", codigo).select("codigo");
                if (error || !Array.isArray(data)) return false;
                return true;
            } catch (e) {
                return false;
            }
        }

        async function excluirTicketSelecionado(ticketId) {
            if (!isAdminUsuario()) { mostrarAlerta("Admin", "Apenas a conta admin pode excluir tickets.", "aviso"); return; }
            const codigo = normalizarCodigoTicket(ticketId);
            if (!codigo) return;
            if (!confirm(`Excluir o ticket ${codigo} DE VERDADE do Supabase e do histórico local? Essa ação é permanente.`)) return;
            const okBanco = await excluirTicketSupabase(codigo);
            const codigoNorm = normalizarCodigoTicket(codigo);
            pedidosAtivos = (Array.isArray(pedidosAtivos) ? pedidosAtivos : []).filter(p => normalizarCodigoTicket(p && (p.ticketId || p.pedidoId)) !== codigoNorm);
            try { localStorage.setItem("marktplace_stand2_pedidos", JSON.stringify(pedidosAtivos)); } catch (e) {}
            const campo = document.getElementById("input-codigo-rastreio");
            if (campo) campo.value = "";
            if (okBanco) {
                mostrarAlerta("Admin", `Ticket ${codigo} excluído do Supabase e do histórico local.`);
            } else {
                mostrarAlerta("Admin", `Ticket ${codigo} removido do histórico local, mas o Supabase recusou a exclusão. Verifique a conexão.`, "aviso");
            }
            await consultarStatusPedido();
        }

        const JANELA_SAIDA_FILA_MS = 3600000;
        let abaTicketsAdmin = "abertos";
        let cronometroSaidaFilaId = null;

        function pararCronometroSaidaFila() {
            if (cronometroSaidaFilaId) { clearInterval(cronometroSaidaFilaId); cronometroSaidaFilaId = null; }
        }

        function ticketNaJanelaAberta(p) {
            if (!p) return false;
            if (!p.concluido || !ticketConcluido(p)) return true;
            if (!p.concluidoEm) return false;
            const fim = new Date(p.concluidoEm).getTime() + JANELA_SAIDA_FILA_MS;
            return Date.now() < fim;
        }

        function restanteSaidaFilaFormatado(iso) {
            if (!iso) return null;
            const resta = new Date(iso).getTime() + JANELA_SAIDA_FILA_MS - Date.now();
            if (!(resta > 0)) return null;
            const t = Math.floor(resta / 1000);
            const m = Math.floor(t / 60);
            const s = t % 60;
            return resta >= 60000 ? `${m}m ${String(s).padStart(2, "0")}s` : `${s}s`;
        }

        function trocarAbaTicketsAdmin(aba) {
            abaTicketsAdmin = aba === "concluidos" ? "concluidos" : "abertos";
            const campo = document.getElementById("input-codigo-rastreio");
            if (campo) campo.value = "";
            consultarStatusPedido();
        }

        async function ticketsEmAbertoSupabase() {
            if (!window.supabaseClient) return null;
            try {
                const limite = new Date(Date.now() - JANELA_SAIDA_FILA_MS).toISOString();
                const { data, error } = await window.supabaseClient
                    .from("tickets")
                    .select("*")
                    .or(`and(concluido.eq.false),and(concluido.eq.true,concluido_em.gte.${limite})`)
                    .order("created_at", { ascending: true });
                if (error || !Array.isArray(data)) return null;
                return data.map(converterRegistroSupabase).filter(ticketNaJanelaAberta);
            } catch (e) {
                return null;
            }
        }

        async function ticketsConcluidosSupabase() {
            if (!window.supabaseClient) return null;
            try {
                const { data, error } = await window.supabaseClient.from("tickets").select("*").eq("concluido", true).order("concluido_em", { ascending: false, nullsFirst: false }).limit(50);
                if (error || !Array.isArray(data)) return null;
                return data.map(converterRegistroSupabase);
            } catch (e) {
                return null;
            }
        }

        function tempoAbertoFormatado(iso) {
            if (!iso) return "desconhecido";
            const abertos = Date.now() - new Date(iso).getTime();
            if (!(abertos >= 0)) return "desconhecido";
            const minutos = Math.floor(abertos / 60000);
            if (minutos < 1) return "menos de 1 min";
            if (minutos < 60) return `há ${minutos} min`;
            const horas = Math.floor(minutos / 60);
            if (horas < 24) return `há ${horas}h${minutos % 60 ? ` ${minutos % 60}m` : ""}`;
            const dias = Math.floor(horas / 24);
            return `há ${dias} dia${dias > 1 ? "s" : ""}${horas % 24 ? ` ${horas % 24}h` : ""}`;
        }

        function estadoPagamentoDoTicket(p) {
            const metodo = escapeHtml(p.metodo || "");
            const valor = escapeHtml(p.total || "");
            if (!metodo && !valor) {
                return '<span class="text-amber-400 font-semibold">Aguardando comprovante (pendente)</span>';
            }
            return `<span class="text-emerald-400 font-semibold">Pagamento em custódia</span> <span class="text-gray-400">(${[metodo, valor].filter(Boolean).join(" — ")})</span>`;
        }

        function cartaoTicketAdmin(p) {
            const concluidoPopular = p.concluido && ticketConcluido(p);
            let faixaRodape = `<span class="text-[10px] text-amber-400 font-semibold">Aguardando ${tempoAbertoFormatado(p.criadoEm)}</span>`;
            if (concluidoPopular) {
                faixaRodape = `<span class="text-[10px] text-emerald-400 font-bold" data-expira="${escapeHtml(p.concluidoEm || "")}">Sai da fila em ${restanteSaidaFilaFormatado(p.concluidoEm) || "0s"}</span>`;
            }
            return `<button type="button" onclick="abrirTicketAdminDaLista('${escapeHtml(p.ticketId)}')" class="w-full text-left bg-[#050505] hover:bg-[#14110c] border ${concluidoPopular ? "border-emerald-500/40" : "border-[#26211a]"} rounded-xl p-2.5 transition cursor-pointer">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <span class="font-mono font-bold text-[var(--accent)]">${escapeHtml(p.ticketId)}</span>
                    <span class="text-[11px] font-bold text-white ${concluidoPopular ? "bg-emerald-500/10 text-emerald-300" : "bg-[#1c1812]"} border border-[#2f2920] rounded-lg px-1.5 py-0.5">Etapa [${etapaAtualDoPedido(p)}/5]${concluidoPopular ? " · concluído" : ""}</span>
                </div>
                <p class="text-[11px] mt-1">${estadoPagamentoDoTicket(p)}</p>
                <p class="text-[11px] text-gray-300 mt-0.5">Cliente: <span class="font-semibold text-white">${escapeHtml(p.nome || p.comprador || "—")}</span>${p.comprador ? ` · ${escapeHtml(p.comprador)}` : ""}${p.whatsapp ? ` · ${escapeHtml(p.whatsapp)}` : ""}</p>
                <p class="text-[11px] text-gray-400 mt-0.5 truncate">Itens: ${escapeHtml(p.itens || "—")}</p>
                <div class="flex items-center justify-between mt-1 gap-2 flex-wrap">
                    ${faixaRodape}
                    <span class="text-[10px] text-[var(--accent)] font-bold">Abrir controles →</span>
                </div>
            </button>`;
        }

        function cartaoTicketHistorico(p) {
            const dataFim = p.concluidoEm ? new Date(p.concluidoEm).toLocaleString("pt-BR") : "data não registrada";
            const metodo = escapeHtml(p.metodo || "—");
            const valor = escapeHtml(p.total || "—");
            return `<button type="button" onclick="abrirTicketAdminDaLista('${escapeHtml(p.ticketId)}')" class="w-full text-left bg-[#050505] hover:bg-[#14110c] border border-[#26211a] rounded-xl p-2.5 transition cursor-pointer">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <span class="font-mono font-bold text-[var(--accent)]">${escapeHtml(p.ticketId)}</span>
                    <span class="text-[11px] font-bold text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 rounded-lg px-1.5 py-0.5">✓ Concluído</span>
                </div>
                <p class="text-[11px] text-gray-300 mt-1">Cliente: <span class="font-semibold text-white">${escapeHtml(p.nome || p.comprador || "—")}</span>${p.comprador ? ` · ${escapeHtml(p.comprador)}` : ""}${p.whatsapp ? ` · ${escapeHtml(p.whatsapp)}` : ""}</p>
                <p class="text-[11px] text-gray-400 mt-0.5 truncate">Itens: ${escapeHtml(p.itens || "—")}</p>
                <div class="flex items-center justify-between mt-1 gap-2 flex-wrap">
                    <span class="text-[11px]">${estadoPagamentoDoTicket(p)}</span>
                </div>
                <p class="text-[10px] text-gray-500 mt-1">Concluído em: <span class="text-gray-300">${escapeHtml(dataFim)}</span> · Total: <span class="text-white font-semibold">${valor}</span> · Método: ${metodo}</p>
            </button>`;
        }

        function barraAbasTicketsAdmin() {
            const abaBtn = (aba, rotulo) => `<button type="button" onclick="trocarAbaTicketsAdmin('${aba}')" class="flex-1 py-2 rounded-lg text-[11px] font-bold cursor-pointer border ${abaTicketsAdmin === aba ? "bg-[var(--accent)] text-black border-[var(--accent)]" : "bg-[#1c1812] text-gray-300 border-[#2f2920] hover:bg-[#26211a]"}">${rotulo}</button>`;
            return `<div class="flex gap-2 mb-3">${abaBtn("abertos", "Em Aberto")}${abaBtn("concluidos", "Concluídos (Histórico)")}</div>`;
        }

        async function renderListaTicketsAdmin() {
            const resBox = document.getElementById("resultado-rastreio");
            if (!resBox) return;
            pararCronometroSaidaFila();
            resBox.classList.remove("hidden");
            if (abaTicketsAdmin === "concluidos") {
                let historico = await ticketsConcluidosSupabase();
                if (historico === null) {
                    historico = (Array.isArray(pedidosAtivos) ? pedidosAtivos : []).filter(p => p && p.ticketId && ticketConcluido(p));
                }
                if (!historico.length) {
                    resBox.innerHTML = `${barraAbasTicketsAdmin()}<p class="text-emerald-400 text-xs font-semibold">Nenhum ticket concluído no histórico ainda.</p>`;
                    return;
                }
                resBox.innerHTML = `${barraAbasTicketsAdmin()}<p class="text-[10px] uppercase font-bold text-[var(--accent)] mb-1.5">Concluídos / arquivados (${historico.length}) <span class="text-gray-500 normal-case">· salvos no Supabase para auditoria</span></p><div class="space-y-2">${historico.map(cartaoTicketHistorico).join("")}</div>`;
                return;
            }
            let lista = await ticketsEmAbertoSupabase();
            if (lista === null) {
                lista = (Array.isArray(pedidosAtivos) ? pedidosAtivos : [])
                    .filter(p => p && p.ticketId && ticketNaJanelaAberta(p))
                    .map(p => Object.assign({ nome: p.comprador || "", whatsapp: p.whatsapp || "", metodo: p.metodo || "", criadoEm: p.criadoEm || null }, p));
            }
            if (!lista.length) {
                resBox.innerHTML = `${barraAbasTicketsAdmin()}<p class="text-emerald-400 text-xs font-semibold">Nenhum ticket em aberto no momento — todos os pedidos ativos foram concluídos.</p>`;
                return;
            }
            resBox.innerHTML = `${barraAbasTicketsAdmin()}<p class="text-[10px] uppercase font-bold text-[var(--accent)] mb-1.5">Fila (${lista.length}) <span class="text-amber-400 normal-case">· atualiza sozinho a cada 4s</span></p><div class="space-y-2">${lista.map(cartaoTicketAdmin).join("")}</div>`;
            iniciarCronometroSaidaFila();
        }

        function iniciarCronometroSaidaFila() {
            pararCronometroSaidaFila();
            cronometroSaidaFilaId = setInterval(() => {
                const modal = document.getElementById("modal-rastreio");
                if (!modal || modal.style.display === "none" || document.hidden) return;
                let expirou = false;
                document.querySelectorAll("[data-expira]").forEach(span => {
                    const resta = restanteSaidaFilaFormatado(span.getAttribute("data-expira"));
                    if (resta) {
                        span.textContent = `Sai da fila em ${resta}`;
                    } else {
                        expirou = true;
                    }
                });
                if (expirou && !document.getElementById("input-codigo-rastreio").value) {
                    pararCronometroSaidaFila();
                    renderListaTicketsAdmin();
                }
            }, 1000);
        }

        function abrirTicketAdminDaLista(codigo) {
            const campo = document.getElementById("input-codigo-rastreio");
            if (campo) campo.value = normalizarCodigoTicket(codigo);
            consultarStatusPedido();
        }
        function voltarListaTicketsAdmin() {
            const campo = document.getElementById("input-codigo-rastreio");
            if (campo) campo.value = "";
            consultarStatusPedido();
        }

        async function consultarStatusPedido(silencioso) {
            const resBox = document.getElementById("resultado-rastreio");
            if (rastreioBuscaEmAndamento) return;
            rastreioBuscaEmAndamento = true;
            try {
                const codigo = normalizarCodigoTicket(document.getElementById("input-codigo-rastreio").value);
                if (!codigo) {
                    if (isAdminUsuario()) { await renderListaTicketsAdmin(); return; }
                    resBox.classList.remove("hidden"); resBox.innerHTML = '<span class="text-red-400">Insira um código válido.</span>'; return;
                }
                let pedidoEncontrado = null;
                if (window.supabaseClient) {
                    if (!silencioso) { resBox.classList.remove("hidden"); resBox.innerHTML = '<p class="text-xs text-gray-400">Consultando o Supabase...</p>'; }
                    const doBanco = await buscarTicketSupabase(codigo);
                    if (doBanco) {
                        pedidoEncontrado = sincronizarPedidoLocal(converterRegistroSupabase(doBanco));
                    }
                }
                if (!pedidoEncontrado) {
                    pedidoEncontrado = pedidosAtivos.find(p => normalizarCodigoTicket(p.ticketId) === codigo || normalizarCodigoTicket(p.pedidoId) === codigo) || null;
                }
                resBox.classList.remove("hidden");
                let html = conteudoPainelIntermediacao(pedidoEncontrado, codigo);
                if (pedidoEncontrado && isAdminUsuario()) {
                    html += `<p class="text-[11px] text-gray-300 mt-1 pt-1 border-t border-[#26211a]">Cliente: <span class="font-semibold text-white">${escapeHtml(pedidoEncontrado.nome || pedidoEncontrado.comprador || "—")}</span>${pedidoEncontrado.comprador ? ` · ${escapeHtml(pedidoEncontrado.comprador)}` : ""}${pedidoEncontrado.whatsapp ? ` · ${escapeHtml(pedidoEncontrado.whatsapp)}` : ""}</p><p class="text-[11px]">${estadoPagamentoDoTicket(pedidoEncontrado)}</p>`;
                    const etapaAtual = etapaAtualDoPedido(pedidoEncontrado);
                    const rotulos = ["1. Pagamento retido", "2. Verificar comprovante", "3. Dados do vendedor", "4. Dados enviados", "5. Concluir Pedido"];
                    const botoes = rotulos.map((rotulo, indice) => {
                        const numero = indice + 1;
                        const ehEtapa5 = numero === 5;
                        const ativo = numero === etapaAtual && !(pedidoEncontrado.concluido && !ehEtapa5);
                        const estilo = ativo
                            ? (ehEtapa5 ? "bg-emerald-500/20 text-emerald-300 border border-emerald-500/50 font-bold" : "bg-[var(--accent)] text-black font-bold")
                            : (ehEtapa5 ? "bg-emerald-500/10 text-emerald-400" : "bg-[#1c1812] text-gray-300");
                        return `<button type="button" onclick="definirEtapaTicketAdmin('${escapeHtml(pedidoEncontrado.ticketId)}', ${numero})" class="${estilo} py-2 rounded-xl text-[11px] cursor-pointer">${rotulo}</button>`;
                    }).join("");
                    html += `<div class="mt-2 border-t border-[#26211a] pt-2"><p class="text-[10px] uppercase font-bold text-white mb-1.5">Controles do Admin (Supabase)</p><div class="grid grid-cols-2 gap-1.5">${botoes}</div><button type="button" onclick="voltarListaTicketsAdmin()" class="mt-2 w-full bg-[#1c1812] hover:bg-[#26211a] text-[var(--accent)] py-2 rounded-xl text-xs font-bold cursor-pointer border border-[#2f2920]">← Voltar para lista em aberto</button></div>`;
                }
                if (isAdminUsuario()) {
                    html += pedidoEncontrado && pedidoEncontrado.ticketId
                        ? `<button type="button" onclick="excluirTicketSelecionado('${escapeHtml(pedidoEncontrado.ticketId)}')" class="mt-2 w-full bg-red-500/10 text-red-400 py-2 rounded-xl text-xs font-bold cursor-pointer border border-red-500/30">🗑 Excluir este ticket (Supabase + local)</button><button type="button" onclick="limparTicketsDeTeste()" class="mt-1.5 w-full bg-red-500/5 text-red-400/80 py-1.5 rounded-xl text-[10px] cursor-pointer border border-red-500/20">🧹 Limpar histórico local</button>`
                        : `<button type="button" onclick="limparTicketsDeTeste()" class="mt-2 w-full bg-red-500/10 text-red-400 py-2 rounded-xl text-xs font-bold cursor-pointer border border-red-500/30">🧹 Limpar Tickets de Teste / Histórico Local</button>`;
                }
                resBox.innerHTML = html;
            } finally {
                rastreioBuscaEmAndamento = false;
            }
        }

        function verificarAutenticacaoAnuncio() {
            fecharMenuMobile();
            if (!currentUser) {
                mostrarAlerta("Atenção", "Você precisa estar logado para anunciar uma conta!", "aviso");
                openModal();
                return;
            }
            if (usuarioEstaBanido(sanitizarNomePublico(currentUser.username), currentUser.email)) {
                mostrarAlerta("Acesso Bloqueado", "Sua conta está banida e não pode anunciar.", "aviso");
                return;
            }
            document.getElementById("preview-vendedor-nome").textContent = sanitizarNomePublico(currentUser.username);
            setModalVisivel("modal-anuncio", true);
        }
        function closeVerificarAnuncio() { setModalVisivel("modal-verificar-anuncio", false); }

        function gerarCodigoVerificacao(email) {
            if (ehEmailAdmin(email) && CODIGO_ADMIN_FIXO) return CODIGO_ADMIN_FIXO;
            return Math.floor(100000 + Math.random() * 900000).toString();
        }

        function emailjsConfigurado() {
            return Boolean(EMAILJS_SERVICE_ID && EMAILJS_TEMPLATE_ID && EMAILJS_PUBLIC_KEY && window.emailjs && typeof window.emailjs.send === "function");
        }

        async function enviarCodigoPorEmail(email, codigo) {
            if (!emailjsConfigurado()) return false;
            try {
                if (!emailjsInicializado) {
                    window.emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });
                    emailjsInicializado = true;
                }
                await window.emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, {
                    to_email: email,
                    email: email,
                    codigo_verificacao: codigo,
                    codigo: codigo,
                    message: `Seu código de verificacao do MARKTPLACE stand2 e: ${codigo}`
                });
                return true;
            } catch (e) {
                return false;
            }
        }

        async function enviarCodigoAnuncio() {
            const email = document.getElementById("anuncio-email").value.trim();
            const feedback = document.getElementById("anuncio-feedback");
            if (!email || !email.endsWith("@gmail.com")) { feedback.textContent = "Insira um Gmail válido."; return; }
            codigoAnuncioSimulado = gerarCodigoVerificacao(email);
            const enviado = await enviarCodigoPorEmail(email, codigoAnuncioSimulado);
            feedback.style.color = "#10b981";
            feedback.textContent = enviado ? "Código enviado para o seu Gmail! Confira a caixa de entrada." : `Código enviado! (Código: ${codigoAnuncioSimulado})`;
            const area = document.getElementById("anuncio-codigo-area");
            if (area) area.classList.remove("hidden");
            const campoCodigo = document.getElementById("anuncio-code");
            if (campoCodigo) campoCodigo.focus();
        }

        function confirmarCodigoAnuncio(event) {
            event.preventDefault();
            const codigoInput = document.getElementById("anuncio-code").value.trim();
            const feedback = document.getElementById("anuncio-feedback");
            if (!codigoAnuncioSimulado || codigoInput !== codigoAnuncioSimulado) {
                feedback.textContent = "Código incorreto!";
                return;
            }
            closeVerificarAnuncio();
            document.getElementById("anuncio-code").value = "";
            feedback.textContent = "";
            document.getElementById("preview-vendedor-nome").textContent = sanitizarNomePublico(currentUser.username);
            setModalVisivel("modal-anuncio", true);
        }
        function closeAnuncioModal() { setModalVisivel("modal-anuncio", false); }

        async function enviarCodigoGmail() {
            const email = document.getElementById("reg-email").value.trim();
            const feedback = document.getElementById("register-feedback");
            if (!email || !email.endsWith("@gmail.com")) { feedback.textContent = "Insira um Gmail válido."; return; }
            codigoEnviadoSimulado = gerarCodigoVerificacao(email);
            const enviado = await enviarCodigoPorEmail(email, codigoEnviadoSimulado);
            feedback.style.color = "#10b981";
            feedback.textContent = enviado ? "Código enviado para o seu Gmail! Confira a caixa de entrada." : `Código enviado! (Código: ${codigoEnviadoSimulado})`;
            const area = document.getElementById("reg-codigo-area");
            if (area) area.classList.remove("hidden");
            const campoCodigo = document.getElementById("reg-code");
            if (campoCodigo) campoCodigo.focus();
        }

        async function handleRegister(event) {
            event.preventDefault();
            const email = document.getElementById("reg-email").value.trim();
            const whatsapp = document.getElementById("reg-whatsapp").value.trim();
            const codigoInput = document.getElementById("reg-code").value.trim();
            let username = document.getElementById("reg-username").value.trim();
            const password = document.getElementById("reg-password").value;
            const passwordConfirm = document.getElementById("reg-password-confirm").value;
            const feedback = document.getElementById("register-feedback");

            if (codigoInput !== codigoEnviadoSimulado) { feedback.textContent = "Código incorreto!"; return; }
            if (password.length < 6 || password !== passwordConfirm) { feedback.textContent = "Senhas inválidas ou não conferem."; return; }

            if (!username) username = `Player_${Math.floor(1000 + Math.random() * 9000)}`;
            let users = JSON.parse(localStorage.getItem("marktplace_stand2_db_users") || "[]");
            if (users.some(u => normalizarIdentificador(u.email) === normalizarIdentificador(email))) { feedback.textContent = "Gmail já cadastrado."; return; }
            if (users.some(u => normalizarIdentificador(u.username) === normalizarIdentificador(username))) { feedback.textContent = "Este nome de usuário já está em uso."; return; }

            feedback.textContent = "Verificando disponibilidade no Supabase...";
            const existente = await buscarUsuarioSupabase(email);
            if (existente) { feedback.textContent = "Gmail já cadastrado."; return; }
            if (await verificarNomeEmUso(username, email)) { feedback.textContent = "Este nome de usuário já está em uso."; return; }

            const avatar = document.getElementById("selected-avatar").value || AVATARES[0];
            const ehAdminNoCadastro = ehEmailAdmin(email);
            const emailNormalizado = email.toLowerCase();
            users.push({ email: emailNormalizado, whatsapp, username, password, avatar, isAdmin: ehAdminNoCadastro });
            localStorage.setItem("marktplace_stand2_db_users", JSON.stringify(users));

            await cadastrarUsuarioSupabase({ email: emailNormalizado, nome: username, senha: password, avatar: avatar, whatsapp: whatsapp || "", ultimo_ajuste_nome: null });

            currentUser = { username, email: emailNormalizado, whatsapp, password, avatar, isAdmin: ehAdminNoCadastro };
            localStorage.setItem("marktplace_stand2_user", JSON.stringify(currentUser));
            aplicarEstadoUsuario();
            closeModal();
            mostrarAlerta("Sucesso!", "Conta criada com sucesso! Bem-vindo ao MARKTPLACE stand2.");
        }

        async function handleLogin(event) {
            event.preventDefault();
            const identifier = document.getElementById("login-identifier").value.trim();
            const password = document.getElementById("login-password").value;
            const feedback = document.getElementById("login-feedback");
            let users = JSON.parse(localStorage.getItem("marktplace_stand2_db_users") || "[]");
            const idLower = identifier.toLowerCase();
            let foundUser = users.find(u => ((u.email || "").toLowerCase() === idLower || (u.username || "").toLowerCase() === idLower) && u.password === password);

            if (!foundUser && ADMIN_SENHA_DIRETA && identifier.toLowerCase() === ADMIN_EMAIL && password === ADMIN_SENHA_DIRETA) {
                foundUser = { email: ADMIN_EMAIL, whatsapp: "", username: "Admin", password: ADMIN_SENHA_DIRETA, avatar: AVATARES[0], isAdmin: true };
                users.push(foundUser);
                localStorage.setItem("marktplace_stand2_db_users", JSON.stringify(users));
            }

            if (!foundUser && window.supabaseClient) {
                feedback.textContent = "Verificando sua conta no Supabase...";
                const row = await buscarUsuarioSupabase(identifier);
                if (row && row.senha === password) {
                    foundUser = { email: row.email, whatsapp: row.whatsapp || "", username: row.nome, password: row.senha, avatar: row.avatar || AVATARES[0], isAdmin: ehEmailAdmin(row.email) };
                    users.push(foundUser);
                    localStorage.setItem("marktplace_stand2_db_users", JSON.stringify(users));
                }
            }

            if (!foundUser) { feedback.textContent = "Dados incorretos."; return; }
            const ehAdminNoLogin = foundUser.email && ehEmailAdmin(foundUser.email);
            currentUser = { username: sanitizarNomePublico(foundUser.username), email: foundUser.email, whatsapp: foundUser.whatsapp || "(Não informado)", password: foundUser.password, avatar: foundUser.avatar, isAdmin: ehAdminNoLogin };
            localStorage.setItem("marktplace_stand2_user", JSON.stringify(currentUser));
            aplicarEstadoUsuario();
            closeModal();
        }

        function aplicarEstadoUsuario() {
            const userPanel = document.getElementById("userPanel");
            const loginBtnContainer = document.getElementById("loginButtonContainer");
            if (currentUser) {
                userPanel.classList.remove("hidden");
                loginBtnContainer.classList.add("hidden");
                document.getElementById("user-avatar-img").src = currentUser.avatar;
                document.getElementById("user-name-text").textContent = sanitizarNomePublico(currentUser.username) + (currentUser.isAdmin || isAdminUsuario() ? " • Admin" : "");
            } else {
                userPanel.classList.add("hidden");
                loginBtnContainer.classList.remove("hidden");
            }
            const menuItemBanidos = document.getElementById("menu-item-banidos");
            if (menuItemBanidos) menuItemBanidos.classList.toggle("hidden", !isAdminUsuario());
            const menuItemConfig = document.getElementById("menu-item-config");
            if (menuItemConfig) menuItemConfig.classList.toggle("hidden", !currentUser);
            carregarCatalogo();
        }

        function logout() {
            currentUser = null;
            localStorage.removeItem("marktplace_stand2_user");
            aplicarEstadoUsuario();
            fecharMenuMobile();
            mostrarAlerta("Sessão Encerrada", "Você saiu com sucesso.");
        }

        async function buscarUsuarioSupabase(identificador) {
            if (!window.supabaseClient || !identificador) return null;
            try {
                const id = normalizarIdentificador(identificador);
                let consulta = window.supabaseClient.from("usuarios").select("*");
                consulta = id.includes("@") ? consulta.eq("email", id) : consulta.ilike("nome", id);
                const { data, error } = await consulta.maybeSingle();
                if (error || !data) return null;
                return data;
            } catch (e) {
                return null;
            }
        }
        function normalizarIdentificador(texto) {
            return String(texto || "").trim().toLowerCase();
        }

        async function cadastrarUsuarioSupabase(registro) {
            if (!window.supabaseClient || !registro || !registro.email) return false;
            try {
                const { error } = await window.supabaseClient.from("usuarios").insert([registro]);
                return !error;
            } catch (e) {
                return false;
            }
        }

        async function verificarNomeEmUso(nome, ignorarEmail) {
            if (!window.supabaseClient || !nome) return false;
            try {
                const { data, error } = await window.supabaseClient.from("usuarios").select("email").ilike("nome", nome);
                if (error || !Array.isArray(data)) return false;
                return data.some(r => normalizarIdentificador(r.email) !== normalizarIdentificador(ignorarEmail));
            } catch (e) {
                return false;
            }
        }

        async function atualizarUsuarioSupabase(email, campos) {
            if (!window.supabaseClient || !email || !campos) return false;
            try {
                const { data, error } = await window.supabaseClient.from("usuarios").update(campos).eq("email", normalizarIdentificador(email)).select("email");
                return !error && Array.isArray(data) && data.length > 0;
            } catch (e) {
                return false;
            }
        }

        function sincronizarUsuarioLocal(usuarioLocal) {
            try {
                const users = JSON.parse(localStorage.getItem("marktplace_stand2_db_users") || "[]");
                const indice = users.findIndex(u => normalizarIdentificador(u.email) === normalizarIdentificador(usuarioLocal.email));
                if (indice >= 0) { users[indice] = Object.assign({}, users[indice], usuarioLocal); } else { users.push(usuarioLocal); }
                localStorage.setItem("marktplace_stand2_db_users", JSON.stringify(users));
            } catch (e) {}
        }

        let recSenhaCodigo = null;
        let recSenhaExpiraEm = 0;
        let recSenhaEmailConta = null;

        function mostrarRecuperacaoSenha() {
            const area = document.getElementById("rec-senha-area");
            if (area) { area.classList.remove("hidden"); const campo = document.getElementById("rec-identifier"); if (campo) campo.focus(); }
            document.getElementById("login-feedback").textContent = "";
        }

        async function gerarCodigoRecuperacao() {
            const identificador = document.getElementById("rec-identifier").value.trim();
            const feedback = document.getElementById("rec-feedback");
            const caixa = document.getElementById("rec-codigo-box");
            feedback.style.color = "#f87171";
            feedback.textContent = "";
            if (!identificador) { feedback.textContent = "Informe seu Gmail ou Nome de usuário."; return; }
            let row = await buscarUsuarioSupabase(identificador);
            if (!row) {
                const users = JSON.parse(localStorage.getItem("marktplace_stand2_db_users") || "[]");
                const local = users.find(u => normalizarIdentificador(u.email) === normalizarIdentificador(identificador) || normalizarIdentificador(u.username) === normalizarIdentificador(identificador));
                if (local) row = { email: local.email, nome: local.username };
            }
            if (!row || !row.email) { caixa.classList.add("hidden"); feedback.textContent = "Conta não encontrada. Confira o Gmail ou Nome digitado."; return; }
            recSenhaCodigo = String(Math.floor(100000 + Math.random() * 900000));
            recSenhaEmailConta = normalizarIdentificador(row.email);
            recSenhaExpiraEm = Date.now() + 5 * 60 * 1000;
            document.getElementById("rec-codigo-valor").textContent = recSenhaCodigo;
            caixa.classList.remove("hidden");
            document.getElementById("rec-nova-senha-area").classList.remove("hidden");
            feedback.style.color = "#10b981";
            feedback.textContent = "Código gerado na caixa acima. Digite-o e defina a nova senha (5 min).";
        }

        async function confirmarRecuperacaoSenha() {
            const feedback = document.getElementById("rec-feedback");
            feedback.style.color = "#f87171";
            const codigo = document.getElementById("rec-code-input").value.trim();
            const nova = document.getElementById("rec-nova-senha").value;
            const conf = document.getElementById("rec-nova-senha-confirm").value;
            if (!recSenhaCodigo || Date.now() > recSenhaExpiraEm) { feedback.textContent = "Código expirado. Gere um novo."; return; }
            if (codigo !== recSenhaCodigo) { feedback.textContent = "Código incorreto."; return; }
            if (nova.length < 6 || nova !== conf) { feedback.textContent = "Nova senha inválida ou não confere."; return; }
            const okBanco = await atualizarUsuarioSupabase(recSenhaEmailConta, { senha: nova });
            sincronizarUsuarioLocal({ email: recSenhaEmailConta, password: nova });
            if (okBanco) {
                feedback.style.color = "#10b981";
                feedback.textContent = "Senha redefinida com sucesso! Faça login com a nova senha.";
                ["rec-identifier", "rec-code-input", "rec-nova-senha", "rec-nova-senha-confirm"].forEach(id => { const el = document.getElementById(id); if (el) el.value = ""; });
                recSenhaCodigo = null; recSenhaEmailConta = null;
            } else {
                feedback.textContent = "Não foi possível gravar no Supabase agora. Tente novamente em instantes.";
            }
        }

        function abrirConfiguracoes() {
            fecharMenuMobile();
            if (!currentUser) { mostrarAlerta("Atenção", "Entre na sua conta para abrir as Configurações.", "aviso"); openModal(); return; }
            document.getElementById("config-avatar-img").src = currentUser.avatar || AVATARES[0];
            document.getElementById("config-nome").textContent = sanitizarNomePublico(currentUser.username);
            document.getElementById("config-email").textContent = currentUser.email || "—";
            document.getElementById("config-novo-nome").value = "";
            document.getElementById("config-whatsapp").value = (currentUser.whatsapp && currentUser.whatsapp !== "(Não informado)") ? currentUser.whatsapp : "";
            ["config-senha-antiga", "config-senha-nova", "config-senha-nova-confirm"].forEach(id => { const el = document.getElementById(id); if (el) el.value = ""; });
            carregarAvataresConfig();
            feedbackConfig("", "");
            setModalVisivel("modal-config", true);
        }
        function closeConfiguracoes() { setModalVisivel("modal-config", false); }
        function feedbackConfig(texto, cor) {
            const f = document.getElementById("config-feedback");
            if (!f) return;
            f.style.color = cor || "";
            f.textContent = texto;
        }

        function carregarAvataresConfig() {
            const grid = document.getElementById("config-avatars-grid");
            if (!grid) return;
            grid.innerHTML = "";
            AVATARES.forEach((url) => {
                const img = document.createElement("img");
                img.src = url;
                img.className = "w-10 h-10 rounded-full cursor-pointer border-2 p-1 bg-[#050505] transition " + (currentUser.avatar === url ? "border-[var(--accent)]" : "border-transparent hover:border-[var(--accent)]");
                img.onclick = function() { aplicarAvatarUsuario(url); };
                grid.appendChild(img);
            });
        }

        async function aplicarAvatarUsuario(avatarUrl) {
            if (!currentUser) return;
            currentUser.avatar = avatarUrl;
            localStorage.setItem("marktplace_stand2_user", JSON.stringify(currentUser));
            sincronizarUsuarioLocal({ email: currentUser.email, avatar: avatarUrl });
            document.getElementById("user-avatar-img").src = avatarUrl;
            document.getElementById("config-avatar-img").src = avatarUrl;
            carregarAvataresConfig();
            const okBanco = await atualizarUsuarioSupabase(currentUser.email, { avatar: avatarUrl });
            feedbackConfig(okBanco ? "Avatar atualizado!" : "Avatar aplicado localmente (Supabase indisponível).", okBanco ? "#10b981" : "#fbbf24");
        }

        function comprimirImagemAvatar(file) {
            return new Promise((resolve) => {
                if (!file) { resolve(null); return; }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        try {
                            const canvas = document.createElement("canvas");
                            let w = img.width, h = img.height;
                            if (w > h) { h = Math.max(1, Math.round(200 * h / w)); w = 200; } else { w = Math.max(1, Math.round(200 * w / h)); h = 200; }
                            canvas.width = w || 200;
                            canvas.height = h || 200;
                            canvas.getContext("2d").drawImage(img, 0, 0, w || 200, h || 200);
                            resolve(canvas.toDataURL("image/jpeg", 0.7));
                        } catch (err) { resolve(null); }
                    };
                    img.onerror = () => resolve(null);
                    img.src = e.target.result;
                };
                reader.onerror = () => resolve(null);
                reader.readAsDataURL(file);
            });
        }

        async function salvarAvatarUpload(file) {
            if (!currentUser) return;
            feedbackConfig("Processando imagem...", "#9ca3af");
            const base64 = await comprimirImagemAvatar(file);
            if (!base64) { feedbackConfig("Falha ao processar a imagem. Tente outro arquivo.", "#f87171"); return; }
            await aplicarAvatarUsuario(base64);
        }

        async function salvarNovoNomeConfig() {
            if (!currentUser) return;
            const novoNome = document.getElementById("config-novo-nome").value.trim();
            if (!novoNome || novoNome.length < 3) { feedbackConfig("Informe um nome com pelo menos 3 caracteres.", "#f87171"); return; }
            feedbackConfig("Verificando regra de 30 dias no Supabase...", "#9ca3af");
            const row = await buscarUsuarioSupabase(currentUser.email);
            const ultimo = row ? row.ultimo_ajuste_nome : null;
            if (ultimo) {
                const decorrido = Date.now() - new Date(ultimo).getTime();
                const diasRestantes = 30 - Math.floor(decorrido / 86400000);
                if (diasRestantes > 0) { feedbackConfig(`Você só pode trocar o nome a cada 30 dias. Faltam ${diasRestantes} dia(s).`, "#fbbf24"); return; }
            }
            if (await verificarNomeEmUso(novoNome, currentUser.email)) { feedbackConfig("Este nome já está em uso por outro usuário.", "#f87171"); return; }
            const agora = new Date().toISOString();
            const okBanco = await atualizarUsuarioSupabase(currentUser.email, { nome: novoNome, ultimo_ajuste_nome: agora });
            currentUser.username = novoNome;
            localStorage.setItem("marktplace_stand2_user", JSON.stringify(currentUser));
            sincronizarUsuarioLocal({ email: currentUser.email, username: novoNome });
            document.getElementById("config-nome").textContent = sanitizarNomePublico(novoNome);
            document.getElementById("config-novo-nome").value = "";
            aplicarEstadoUsuario();
            feedbackConfig(okBanco ? "Nome atualizado! Próxima troca liberada em 30 dias." : "Nome atualizado localmente (Supabase indisponível).", okBanco ? "#10b981" : "#fbbf24");
        }

        async function salvarWhatsAppConfig() {
            if (!currentUser) return;
            const wpp = document.getElementById("config-whatsapp").value.trim().replace(/\D/g, "");
            if (!wpp || wpp.length < 10) { feedbackConfig("Informe um número válido com DDD (ex: 11999999999).", "#f87171"); return; }
            feedbackConfig("Salvando WhatsApp...", "#9ca3af");
            const okBanco = await atualizarUsuarioSupabase(currentUser.email, { whatsapp: wpp });
            currentUser.whatsapp = wpp;
            localStorage.setItem("marktplace_stand2_user", JSON.stringify(currentUser));
            sincronizarUsuarioLocal({ email: currentUser.email, whatsapp: wpp });
            feedbackConfig(okBanco ? "WhatsApp salvo! Ele pré-preencherá o checkout/suporte." : "WhatsApp salvo localmente (Supabase indisponível).", okBanco ? "#10b981" : "#fbbf24");
        }

        async function salvarNovaSenhaConfig() {
            if (!currentUser) return;
            const antiga = document.getElementById("config-senha-antiga").value;
            const nova = document.getElementById("config-senha-nova").value;
            const conf = document.getElementById("config-senha-nova-confirm").value;
            if (nova.length < 6) { feedbackConfig("A nova senha precisa ter pelo menos 6 caracteres.", "#f87171"); return; }
            if (nova !== conf) { feedbackConfig("A confirmação não confere com a nova senha.", "#f87171"); return; }
            feedbackConfig("Validando senha antiga no Supabase...", "#9ca3af");
            const row = await buscarUsuarioSupabase(currentUser.email);
            const senhaAtual = row ? row.senha : currentUser.password;
            if (antiga !== senhaAtual) { feedbackConfig("Senha antiga incorreta.", "#f87171"); return; }
            const okBanco = await atualizarUsuarioSupabase(currentUser.email, { senha: nova });
            currentUser.password = nova;
            localStorage.setItem("marktplace_stand2_user", JSON.stringify(currentUser));
            sincronizarUsuarioLocal({ email: currentUser.email, password: nova });
            ["config-senha-antiga", "config-senha-nova", "config-senha-nova-confirm"].forEach(id => { const el = document.getElementById(id); if (el) el.value = ""; });
            feedbackConfig(okBanco ? "Senha atualizada com sucesso!" : "Senha atualizada localmente (Supabase indisponível).", okBanco ? "#10b981" : "#fbbf24");
        }

        async function inicializarAnuncios() {
            if (window.supabaseClient) {
                try {
                    const { data, error } = await window.supabaseClient.from("contas").select("*").order("id", { ascending: false });
                    if (error) {
                    } else if (Array.isArray(data)) {
                        anunciosEmMemoria = data.map(normalizarAnuncio);
                        localStorage.setItem("marktplace_stand2_anuncios", JSON.stringify(anunciosEmMemoria));
                        carregarCatalogo();
                        return;
                    }
                } catch (e) {
                    console.error("❌ Exceção ao consultar Supabase:", e);
                }
            }
            const salvos = localStorage.getItem("marktplace_stand2_anuncios");
            if (salvos) {
                try {
                    const parsed = JSON.parse(salvos);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        anunciosEmMemoria = parsed.map(normalizarAnuncio);
                        carregarCatalogo();
                        return;
                    }
                } catch (e) {}
            }
            anunciosEmMemoria = [normalizarAnuncio({
                id: "default_1",
                titulo: "Conta com M9 Bayonet & AKR",
                preco: "R$ 150,00",
                rank: "Master",
                vinculo: "Google ID",
                descricao: "• M9 Bayonet | Treasure Hunter (Pattern: 412)\n• Gloves | Carbon (Pattern: 12)\n• AKR | Sport • AWM | Scratch",
                vendedor: "Sistema",
                likes: 12,
                curtidoPormim: false,
                fotos: []
            })];
            carregarCatalogo();
        }

        function formatarPrecoMoeda(valorStr) {
            let limpo = valorStr.replace(/[^\d,.]/g, "").trim();
            if (!limpo) return "R$ 0,00";
            limpo = limpo.replace(".", ",");
            if (!limpo.includes(",")) {
                limpo = limpo + ",00";
            } else {
                let partes = limpo.split(",");
                if (partes[1].length === 1) {
                    limpo = partes[0] + "," + partes[1] + "0";
                }
            }
            return `R$ ${limpo}`;
        }

        function carregarCatalogo() {
            const grid = document.getElementById("catalogo-cards");
            if (!grid) return;
            grid.innerHTML = "";
            const adminVendo = isAdminUsuario();
            anunciosEmMemoria.forEach((anuncio, index) => {
                const item = normalizarAnuncio(anuncio);
                const vendedorCardBanido = usuarioEstaBanido(sanitizarNomePublico(item.vendedor), "");
                if (vendedorCardBanido && !adminVendo) return;
                const card = document.createElement("div");
                card.className = "bg-[#16130e] border border-[#26211a] rounded-[20px] p-5 flex flex-col justify-between hover:border-[#41382a] transition shadow-xl relative card-marketplace animate-fade-in-up fade-stagger";
                card.style.animationDelay = `${0.08 + index * 0.06}s`;
                const ehDono = currentUser && sanitizarNomePublico(currentUser.username) === sanitizarNomePublico(item.vendedor);
                const capaHtml = (item.fotos && item.fotos.length > 0) ? `<div class="w-full h-40 bg-black rounded-xl overflow-hidden mb-4 border border-[#26211a] relative"><img src="${item.fotos[0]}" alt="Capa da conta" class="w-full h-full object-cover"><span class="absolute bottom-2 right-2 bg-black/75 text-white text-[10px] px-2 py-0.5 rounded">${item.fotos.length} foto(s)</span></div>` : "";
                let barraSuperior = "";
                if (ehDono) {
                    barraSuperior = `<div class="flex justify-between items-center mb-3 pb-2 border-b border-[#26211a]"><span class="text-[10px] text-gray-400 font-semibold uppercase">Seu Anúncio</span><button type="button" onclick="removerAnuncio('${escapeHtml(item.id)}')" class="bg-red-500/15 text-red-400 px-2 py-0.5 rounded text-xs font-bold cursor-pointer">Remover</button></div>`;
                } else if (adminVendo) {
                    barraSuperior = `<div class="flex justify-between items-center mb-3 pb-2 border-b border-[#26211a]"><span class="text-[10px] font-semibold uppercase ${vendedorCardBanido ? "text-red-400" : "text-[var(--accent)]"}">${vendedorCardBanido ? "Vendedor Banido" : "Ação Admin"}</span><span class="flex gap-1.5"><button type="button" onclick="excluirAnuncioAdmin('${escapeHtml(item.id)}')" class="bg-red-500/15 text-red-400 px-2 py-0.5 rounded text-xs font-bold cursor-pointer">Excluir</button><button type="button" onclick="alternarBanimentoVendedor('${vendedorCardBanido ? "desbanir" : "banir"}','${escapeHtml(item.id)}')" class="bg-amber-500/10 text-amber-400 px-2 py-0.5 rounded text-xs font-bold cursor-pointer">${vendedorCardBanido ? "Desbanir" : "Banir"}</button></span></div>`;
                }
                const corJoinha = item.curtidoPormim ? "text-[#ffffff] font-bold drop-shadow-[0_0_6px_rgba(255,255,255,0.9)]" : "text-[#777777]";
                card.innerHTML = `<div>${barraSuperior}${capaHtml}<div class="flex justify-between items-center mb-3 gap-2"><span class="bg-[#1c1812] border border-[#2f2920] text-amber-400 text-xs font-bold px-2.5 py-1 rounded uppercase">${escapeHtml(item.rank)}</span><div class="flex items-center gap-2"><button type="button" onclick="curtirAnuncio('${escapeHtml(item.id)}')" class="bg-[#1c1812] hover:bg-[#26211a] border border-[#2f2920] text-xs px-2.5 py-1 rounded-lg flex items-center gap-1.5 transition cursor-pointer"><span class="like-btn ${corJoinha}" id="like-${escapeHtml(item.id)}">👍</span> <span class="text-gray-300 font-semibold">${item.likes || 0}</span></button><span class="text-lg font-bold text-emerald-400">${escapeHtml(item.preco)}</span></div></div><h3 class="font-bold text-lg mb-1 text-white">${escapeHtml(item.titulo)}</h3><p class="text-xs text-[var(--muted)] mb-1">Vínculo: ${escapeHtml(item.vinculo)}</p><p class="text-xs text-gray-400 mb-3">Vendedor: ${escapeHtml(sanitizarNomePublico(item.vendedor))}</p></div><div class="space-y-2 mt-4"><button type="button" onclick="abrirDetalhes('${escapeHtml(item.id)}')" class="w-full bg-[#1c1812] hover:bg-[#26211a] border border-[#2f2920] text-white py-2 rounded-xl text-xs font-bold transition cursor-pointer">Ver Detalhes</button><button type="button" onclick="adicionarAoCarrinho('${escapeHtml(item.id)}')" class="w-full bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-black py-2 rounded-xl text-xs font-bold transition cursor-pointer">🛒 Adicionar ao Carrinho</button></div>`;
                grid.appendChild(card);
            });
        }

        async function curtirAnuncio(id) {
            const anuncio = anunciosEmMemoria.find(a => String(a.id) === String(id));
            if (!anuncio) return;
            const likesAtual = Number(anuncio.likes || 0);
            const proximoCurtido = !Boolean(anuncio.curtidoPormim);
            const proximoLikes = proximoCurtido ? likesAtual + 1 : Math.max(0, likesAtual - 1);
            anuncio.curtidoPormim = proximoCurtido;
            anuncio.likes = proximoLikes;
            localStorage.setItem("marktplace_stand2_anuncios", JSON.stringify(anunciosEmMemoria));
            carregarCatalogo();
            if (window.supabaseClient && ehIdNumerico(anuncio.id)) {
                try {
                    const { error } = await window.supabaseClient.from("contas").update({
                        curtidoPormim: proximoCurtido,
                        likes: proximoLikes
                    }).eq("id", Number(anuncio.id));
                    if (error) {}
                } catch (e) {}
            }
        }

        function adicionarAoCarrinho(id) {
            const anuncio = anunciosEmMemoria.find(a => String(a.id) === String(id));
            if (!anuncio) return;
            if (carrinhoItens.some(item => String(item.id) === String(id))) {
                mostrarAlerta("Carrinho", "Este item já está no seu carrinho!", "aviso");
                return;
            }
            carrinhoItens.push(anuncio);
            localStorage.setItem("marktplace_stand2_cart", JSON.stringify(carrinhoItens));
            atualizarBadgeCarrinho();
            mostrarAlerta("Sucesso", "Conta adicionada ao carrinho!");
        }

        function adicionarAoCarrinhoAtual() {
            if (!anuncioSelecionadoAtual) return;
            closeDetalhes();
            adicionarAoCarrinho(anuncioSelecionadoAtual.id);
        }

        function atualizarBadgeCarrinho() {
            const badge = document.getElementById("cart-badge");
            if (badge) badge.textContent = carrinhoItens.length;
        }

        function abrirCarrinho() {
            const container = document.getElementById("carrinho-itens");
            const totalEl = document.getElementById("carrinho-total");
            container.innerHTML = "";
            if (carrinhoItens.length === 0) {
                container.innerHTML = '<p class="text-xs text-gray-400 text-center py-6">Seu carrinho está vazio.</p>';
                totalEl.textContent = "R$ 0,00";
            } else {
                let totalSoma = 0;
                carrinhoItens.forEach((item, index) => {
                    let numPreco = parseFloat(item.preco.replace("R$", "").replace(".", "").replace(",", ".").trim()) || 0;
                    totalSoma += numPreco;
                    const div = document.createElement("div");
                    div.className = "flex justify-between items-center bg-[#050505] p-3 rounded-xl border border-[#26211a]";
                    div.innerHTML = `<div><p class="text-xs font-bold text-white">${escapeHtml(item.titulo)}</p><span class="text-xs text-emerald-400 font-semibold">${escapeHtml(item.preco)}</span></div><button type="button" onclick="removerDoCarrinho(${index})" class="text-red-400 hover:text-red-300 text-xs font-bold bg-red-500/10 px-2 py-1 rounded cursor-pointer">Remover</button>`;
                    container.appendChild(div);
                });
                totalEl.textContent = `R$ ${totalSoma.toFixed(2).replace(".", ",")}`;
            }
            document.getElementById("modal-carrinho").style.display = "flex";
        }

        function closeCarrinho() { setModalVisivel("modal-carrinho", false); }

        function removerDoCarrinho(index) {
            carrinhoItens.splice(index, 1);
            localStorage.setItem("marktplace_stand2_cart", JSON.stringify(carrinhoItens));
            atualizarBadgeCarrinho();
            abrirCarrinho();
        }

        function finalizarCompraCarrinho() {
            if (carrinhoItens.length === 0) { mostrarAlerta("Aviso", "Seu carrinho está vazio.", "aviso"); return; }
            closeCarrinho();
            if (!currentUser) { mostrarAlerta("Login Necessário", "Entre na sua conta para finalizar o pagamento.", "aviso"); openModal(); return; }
            document.getElementById("modal-checkout").style.display = "flex";
        }

        function abrirCheckoutDireto() {
            if (!currentUser) { closeDetalhes(); mostrarAlerta("Login Necessário", "Entre para comprar.", "aviso"); openModal(); return; }
            closeDetalhes();
            if (anuncioSelecionadoAtual && !carrinhoItens.some(i => String(i.id) === String(anuncioSelecionadoAtual.id))) {
                carrinhoItens = [anuncioSelecionadoAtual];
            }
            document.getElementById("modal-checkout").style.display = "flex";
        }
        function closeCheckout() { setModalVisivel("modal-checkout", false); }

        function mudarMetodoPagamento(metodo) {
            const caixaCartao = document.getElementById("container-campos-cartao");
            if (metodo === "cartao") {
                caixaCartao.classList.remove("hidden");
            } else {
                caixaCartao.classList.add("hidden");
            }
        }

        function comprimirImagem(file) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        const canvas = document.createElement("canvas");
                        let w = img.width, h = img.height;
                        if (w > 800) { h *= 800 / w; w = 800; }
                        canvas.width = w;
                        canvas.height = h;
                        const ctx = canvas.getContext("2d");
                        ctx.filter = "none";
                        ctx.drawImage(img, 0, 0, w, h);
                        resolve(canvas.toDataURL("image/jpeg", 0.7));
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        const catalogoStandoff2 = {
            rifles: ["M4A4", "M4A1-S", "AK-47", "AK-74U", "AWP", "SG 553", "G3SG1", "SCAR-20", "MAG-7", "NOVA", "XM1014"],
            skins: {
                "M9 Bayonet": ["Treasure Hunter", "Lore", "Fade", "Doppler", "Chrome"],
                "Gloves": ["Carbon", "Sport", "Driver", "Motorsports", "Crystalline"],
                "AK-47": ["Fire Serpent", "Redline", "Case Hardened", "Midnight", "Black Laminate"],
                "AWP": ["Dragon Lore", "Hyper Beast", "Gungnir", "Medusa", "asi127"],
                "M4A4": ["Howl", "Fire Serpent", "Hyper Beast", "Emperor", "Neon Kimera"],
                "USP-S": ["Abyss", "Night", "Master", "Royal", "Yellow Jacket"],
                "P250": ["Bone Snake", "El Dorado", "Guardian", "Oasis", "Vivid"],
                "Glock-18": ["Fade", "Water Elemental", "Radiation", "Crimson Web", "Heirloom"]
            },
            patterns: ["412", "12", "318", "661", "823", "947", "000", "100", "200", "300"],
            itens_especiais: ["Tie Dye", "Jade Stone"]
        };

        const ARMAS_STANDOFF2_NOMES = [
            "M9 Bayonet", "Butterfly", "Karambit", "Kunai", "Tanto", "Daggers", "Stiletto", "Flip Knife", "Fang", "Jaws", "Scythe",
            "AKR12", "AKR", "AK-47", "AK-74U", "M16", "M4A4", "M4A1", "M4", "AWM", "AWP", "M40", "M110", "Mallard", "M60",
            "FAMAS", "VAL", "Akimbo Uzi", "F/S", "Berettas", "Gloves",
            "USP-S", "USP", "G22", "Glock-18", "Desert Eagle", "Deagle", "P350", "P250", "Five-SeveN",
            "TEC-9", "MAC-10", "MP7", "UMP45", "P90", "SM1014", "FABM", "SPAS"
        ];

        function canonizarParaOCR(valor) {
            return (valor || "").toLowerCase().replace(/[^a-z0-9]/g, "").replace(/0/g, "o").replace(/[1i]/g, "l").replace(/5/g, "s");
        }

        const ARMAS_STANDOFF2_CANON = ARMAS_STANDOFF2_NOMES.map(nome => ({ nome: nome, canon: canonizarParaOCR(nome) }));

        function diferencaNoMaximoUm(a, b) {
            if (a === b) return true;
            const menor = a.length <= b.length ? a : b;
            const maior = a.length <= b.length ? b : a;
            if (maior.length - menor.length > 1) return false;
            let i = 0, j = 0, difs = 0;
            while (i < menor.length && j < maior.length) {
                if (menor[i] === maior[j]) { i++; j++; continue; }
                difs++;
                if (difs > 1) return false;
                if (menor[i] === maior[j + 1] && menor[i + 1] === maior[j]) { i += 2; j += 2; continue; }
                if (menor.length === maior.length) { i++; j++; } else { j++; }
            }
            return true;
        }

        function extrairApenasNomesArmas(textoBruto) {
            if (!textoBruto) return [];
            const tokens = textoBruto.toLowerCase().split(/[^a-z0-9]+/).map(canonizarParaOCR).filter(Boolean);
            const encontradas = [];
            for (let i = 0; i < tokens.length; i++) {
                let janela = "";
                for (let k = i; k < Math.min(tokens.length, i + 3); k++) {
                    janela += tokens[k];
                    for (const arma of ARMAS_STANDOFF2_CANON) {
                        if (arma.canon.length < 2) continue;
                        const confere = janela === arma.canon || (arma.canon.length >= 5 && diferencaNoMaximoUm(janela, arma.canon));
                        if (confere && !encontradas.includes(arma.nome)) encontradas.push(arma.nome);
                    }
                }
            }
            return encontradas;
        }

        const CATEGORIAS_ITENS_STANDOFF2 = [
            ["Facas", ["M9 Bayonet", "Butterfly", "Karambit", "Kunai", "Tanto", "Daggers", "Stiletto", "Flip Knife", "Fang", "Jaws", "Scythe"]],
            ["Rifles", ["AKR12", "AKR", "AK-47", "AK-74U", "M16", "M4A4", "M4A1", "M4", "AWM", "AWP", "M40", "M110", "Mallard", "M60", "FAMAS", "VAL"]],
            ["Pistolas", ["F/S", "Berettas", "USP-S", "USP", "G22", "Glock-18", "Desert Eagle", "Deagle", "P350", "P250", "Five-SeveN"]],
            ["SMGs", ["Akimbo Uzi", "TEC-9", "MAC-10", "MP7", "UMP45", "P90", "SM1014"]],
            ["Shotguns", ["FABM", "SPAS"]],
            ["Luvas e itens", ["Gloves"]]
        ];

        function montarDescricaoOrganizada(contagem) {
            const nomes = Object.keys(contagem || {});
            if (!nomes.length) return "";
            const usados = new Set();
            const linhas = [];
            for (const [categoria, itensCategoria] of CATEGORIAS_ITENS_STANDOFF2) {
                const parte = itensCategoria
                    .filter(nome => contagem[nome])
                    .map(nome => { usados.add(nome); return `${nome} x${contagem[nome]}`; });
                if (parte.length) linhas.push(`${categoria}: ${parte.join(", ")}`);
            }
            const fora = nomes.filter(nome => contagem[nome] && !usados.has(nome))
                .map(nome => `${nome} x${contagem[nome]}`);
            if (fora.length) linhas.push(`Outros: ${fora.join(", ")}`);
            return linhas.join("\n");
        }

        function carregarImagemDeArquivo(file) {
            return new Promise((resolve, reject) => {
                const url = URL.createObjectURL(file);
                const img = new Image();
                img.onload = function() { URL.revokeObjectURL(url); resolve(img); };
                img.onerror = function(e) { URL.revokeObjectURL(url); reject(e); };
                img.src = url;
            });
        }

        function desenharVarianteOCR(img, escala, contraste) {
            const maxLado = 2200;
            let w = img.width * escala, h = img.height * escala;
            const fator = Math.min(1, maxLado / Math.max(w, h));
            w = Math.round(w * fator);
            h = Math.round(h * fator);
            const canvas = document.createElement("canvas");
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext("2d", { willReadFrequently: true });
            ctx.drawImage(img, 0, 0, w, h);
            if (contraste > 0) {
                const dados = ctx.getImageData(0, 0, w, h);
                const px = dados.data;
                const fatorC = (259 * (contraste + 255)) / (255 * (259 - contraste));
                for (let i = 0; i < px.length; i += 4) {
                    const cinza = 0.299 * px[i] + 0.587 * px[i + 1] + 0.114 * px[i + 2];
                    const c = Math.max(0, Math.min(255, fatorC * (cinza - 128) + 128));
                    px[i] = c; px[i + 1] = c; px[i + 2] = c;
                }
                ctx.putImageData(dados, 0, 0);
            }
            return canvas;
        }

        async function reconhecerArmasEmFoto(file) {
            if (!(window.Tesseract && typeof window.Tesseract.recognize === "function")) return [];
            const armas = [];
            try {
                const img = await carregarImagemDeArquivo(file);
                const tentativas = [
                    { escala: 1, contraste: 0 },
                    { escala: 1.5, contraste: 60 },
                    { escala: 2, contraste: 60 }
                ];
                for (const t of tentativas) {
                    try {
                        const canvas = desenharVarianteOCR(img, t.escala, t.contraste);
                        const resultado = await window.Tesseract.recognize(canvas, "eng");
                        const novas = extrairApenasNomesArmas(resultado && resultado.data ? resultado.data.text : "");
                        for (const a of novas) {
                            if (!armas.includes(a)) armas.push(a);
                        }
                        if (armas.length >= 6) break;
                    } catch (e) {}
                }
            } catch (e) {}
            return armas;
        }

        async function processarFotosInventario(input) {
            if (!input.files || input.files.length === 0) return;
            fotosNovasBase64 = [];
            const totalFotos = Math.min(input.files.length, 7);
            for (let i = 0; i < totalFotos; i++) {
                const comp = await comprimirImagem(input.files[i]);
                if (comp) fotosNovasBase64.push(comp);
            }
            const campoDesc = document.getElementById("conta-desc");
            const contagemArmas = {};
            if (campoDesc) campoDesc.value = "Lendo nomes das armas nas imagens...";
            try {
                const tarefasOCR = [];
                for (let i = 0; i < Math.min(input.files.length, 7); i++) {
                    tarefasOCR.push(
                        reconhecerArmasEmFoto(input.files[i])
                            .then(armas => {
                                const unicas = Array.from(new Set(armas));
                                for (const a of unicas) contagemArmas[a] = (contagemArmas[a] || 0) + 1;
                            })
                            .catch(() => {})
                    );
                }
                await Promise.all(tarefasOCR);
            } finally {
                if (campoDesc) {
                    campoDesc.value = montarDescricaoOrganizada(contagemArmas);
                }
            }
        }

        function limparAvisoConfianca() {
            const existentes = document.querySelectorAll(".confianca-avisos");
            existentes.forEach(el => el.remove());
        }

        async function publicarAnuncioFinal() {
            const btnPublicar = document.getElementById("btn-publicar-anuncio");
            const titulo = document.getElementById("conta-titulo").value.trim();
            const precoInput = document.getElementById("conta-preco").value.trim();
            const rank = document.getElementById("conta-rank").value;
            const vinculo = document.getElementById("conta-vinculo").value;
            let descFinal = document.getElementById("conta-desc").value.trim();

            if (currentUser && usuarioEstaBanido(sanitizarNomePublico(currentUser.username), currentUser.email)) {
                mostrarAlerta("Acesso Bloqueado", "Sua conta está banida e não pode publicar anúncios.", "aviso");
                return;
            }
            if (!titulo || !precoInput) { mostrarAlerta("Aviso", "Preencha título e preço.", "aviso"); return; }
            if (fotosNovasBase64.length === 0) { mostrarAlerta("Aviso", "Adicione pelo menos um print do inventário.", "aviso"); return; }

            const maxTotalBytes = 2 * 1024 * 1024;
            let totalBytes = 0;
            for (const photo of fotosNovasBase64) {
                const base64Part = photo.split("base64,")[1] || "";
                totalBytes += base64Part.length * 3 / 4;
            }
            if (totalBytes > maxTotalBytes) {
                mostrarAlerta("Aviso", "Total de fotos muito grande. Reduza o número de imagens ou use fotos menores.", "aviso");
                return;
            }

            if (!descFinal) {
                descFinal = "• Inventário verificado e garantido.";
            }

            const precoFormatado = formatarPrecoMoeda(precoInput);

            let anuncioParaSalvar = normalizarAnuncio({
                id: "local_" + Date.now(),
                titulo,
                preco: precoFormatado,
                rank,
                vinculo,
                descricao: descFinal,
                vendedor: sanitizarNomePublico(currentUser ? currentUser.username : "Jogador"),
                likes: 0,
                curtidoPormim: false,
                fotos: [...fotosNovasBase64]
            });

            if (btnPublicar) {
                btnPublicar.disabled = true;
                btnPublicar.textContent = "Publicando...";
            }

            let salvoNoBanco = false;

            if (window.supabaseClient) {
                try {
                    const { data: inseridos, error } = await window.supabaseClient.from("contas").insert([prepararPayloadSupabase(anuncioParaSalvar, false)]).select("*");
                    if (error) {
                        console.error("Erro ao salvar no Supabase:", error);
                        mostrarAlerta("Erro ao Salvar no Banco", `O Supabase recusou o anúncio (${error.code || "erro"}): ${error.message}`, "aviso");
                    } else {
                        salvoNoBanco = true;
                        if (Array.isArray(inseridos) && inseridos.length > 0) {
                            anuncioParaSalvar = normalizarAnuncio(inseridos[0]);
                        }
                    }
                } catch (e) {
                    console.error("Exceção ao salvar no Supabase:", e);
                    mostrarAlerta("Erro de Conexão", "Não foi possível comunicar com o Supabase.", "aviso");
                }
            } else {
                mostrarAlerta("Modo Local", "Cliente Supabase indisponível; anúncio salvo apenas neste navegador.", "aviso");
            }

            if (btnPublicar) {
                btnPublicar.disabled = false;
                btnPublicar.textContent = "Publicar Conta";
            }

            if (!salvoNoBanco && window.supabaseClient) {
                return;
            }

            anunciosEmMemoria.unshift(anuncioParaSalvar);
            localStorage.setItem("marktplace_stand2_anuncios", JSON.stringify(anunciosEmMemoria));
            fotosNovasBase64 = [];

            document.getElementById("conta-titulo").value = "";
            document.getElementById("conta-preco").value = "";
            document.getElementById("conta-desc").value = "";
            document.getElementById("conta-fotos").value = "";

            carregarCatalogo();
            closeAnuncioModal();
            mostrarAlerta("Sucesso", "Conta publicada e salva no banco com sucesso!");
        }

        function isAdminUsuario() {
            return Boolean(currentUser && currentUser.email && ehEmailAdmin(currentUser.email));
        }

        function carregarBanidos() {
            try {
                const lista = JSON.parse(localStorage.getItem(CHAVE_STORAGE_BANIDOS) || "[]");
                return Array.isArray(lista) ? lista : [];
            } catch (e) {
                return [];
            }
        }

        function salvarBanidos(lista) {
            localStorage.setItem(CHAVE_STORAGE_BANIDOS, JSON.stringify(lista));
        }

        function usuarioEstaBanido(nome, email) {
            const alvoNome = (nome || "").toLowerCase();
            const alvoEmail = (email || "").toLowerCase();
            if (!alvoNome && !alvoEmail) return false;
            return carregarBanidos().some(b => {
                const confereNome = Boolean(b && b.nome && alvoNome && String(b.nome).toLowerCase() === alvoNome);
                const confereEmail = Boolean(b && b.email && alvoEmail && String(b.email).toLowerCase() === alvoEmail);
                return confereNome || confereEmail;
            });
        }

        function resolverEmailDoVendedor(nomeVendedor) {
            try {
                const users = JSON.parse(localStorage.getItem("marktplace_stand2_db_users") || "[]");
                const u = users.find(x => sanitizarNomePublico(x.username) === sanitizarNomePublico(nomeVendedor));
                return u ? (u.email || "") : "";
            } catch (e) {
                return "";
            }
        }

        async function sincronizarBanidosSupabase() {
            if (!window.supabaseClient) return;
            try {
                const { data, error } = await window.supabaseClient.from("usuarios_banidos").select("nome,email");
                if (!error && Array.isArray(data)) {
                    const lista = carregarBanidos();
                    let mudou = false;
                    for (const b of data) {
                        if (b && b.nome && !lista.some(x => (x.nome || "").toLowerCase() === String(b.nome).toLowerCase())) {
                            lista.push({ nome: String(b.nome), email: b.email || "", data: "" });
                            mudou = true;
                        }
                    }
                    if (mudou) {
                        salvarBanidos(lista);
                        carregarCatalogo();
                    }
                }
            } catch (e) {}
        }

        async function excluirAnuncioAdmin(id) {
            if (!isAdminUsuario()) { mostrarAlerta("Admin", "Apenas a conta admin pode excluir anúncios.", "aviso"); return; }
            const alvo = anunciosEmMemoria.find(a => String(a.id) === String(id));
            if (!alvo) { mostrarAlerta("Admin", "Anúncio não encontrado.", "aviso"); return; }
            await removerAnuncio(id);
            mostrarAlerta("Admin", `Anúncio "${sanitizarNomePublico(alvo.titulo)}" excluído do Supabase e do catálogo.`);
        }

        async function excluirAnuncioAdminSelecionado() {
            if (!anuncioSelecionadoAtual) return;
            const id = anuncioSelecionadoAtual.id;
            closeDetalhes();
            await excluirAnuncioAdmin(id);
        }

        async function banirVendedorDoAnuncio(id) {
            if (!isAdminUsuario()) return;
            const anuncio = anunciosEmMemoria.find(a => String(a.id) === String(id));
            if (!anuncio) return;
            const nome = sanitizarNomePublico(anuncio.vendedor);
            if (currentUser && nome === sanitizarNomePublico(currentUser.username)) { mostrarAlerta("Admin", "Você não pode banir a própria conta admin.", "aviso"); return; }
            if (!confirm(`Banir o usuário "${nome}"? Os anúncios dele saem do catálogo e ele não poderá publicar.`)) return;
            const lista = carregarBanidos();
            if (!lista.some(b => (b.nome || "").toLowerCase() === nome.toLowerCase())) {
                lista.push({ nome, email: resolverEmailDoVendedor(nome), data: new Date().toISOString() });
                salvarBanidos(lista);
            }
            if (window.supabaseClient) {
                try {
                    await window.supabaseClient.from("usuarios_banidos").insert([{ nome, email: resolverEmailDoVendedor(nome) }]);
                } catch (e) {}
            }
            const idsDoVendedor = anunciosEmMemoria
                .filter(a => sanitizarNomePublico(a.vendedor) === nome)
                .map(a => String(a.id));
            for (const idAnuncio of idsDoVendedor) {
                try { await removerAnuncio(idAnuncio); } catch (e) {}
            }
            if (anuncioSelecionadoAtual && idsDoVendedor.includes(String(anuncioSelecionadoAtual.id))) {
                closeDetalhes();
            }
            carregarCatalogo();
            mostrarAlerta("Admin", `Usuário "${nome}" banido. Anúncios dele removidos do catálogo e publicação bloqueada.`, "aviso");
        }

        async function desbanirVendedorDoAnuncio(id) {
            if (!isAdminUsuario()) return;
            const anuncio = anunciosEmMemoria.find(a => String(a.id) === String(id));
            if (!anuncio) return;
            const nome = sanitizarNomePublico(anuncio.vendedor);
            if (!confirm(`Desbanir o usuário "${nome}"? Os anúncios dele voltam ao catálogo quando recarregar.`)) return;
            salvarBanidos(carregarBanidos().filter(b => (b.nome || "").toLowerCase() !== nome.toLowerCase()));
            if (window.supabaseClient) {
                try {
                    await window.supabaseClient.from("usuarios_banidos").delete().eq("nome", nome);
                } catch (e) {}
            }
            carregarCatalogo();
            mostrarAlerta("Admin", `Usuário "${nome}" desbanido.`);
        }

        async function alternarBanimentoVendedor(action, id) {
            if (action === "banir") { await banirVendedorDoAnuncio(id); }
            else { await desbanirVendedorDoAnuncio(id); }
        }

        async function openPainelBanidos() {
            if (!isAdminUsuario()) { mostrarAlerta("Admin", "Apenas a conta admin pode abrir este painel.", "aviso"); return; }
            try { await sincronizarBanidosSupabase(); } catch (e) {}
            renderizarListaBanidos();
            setModalVisivel("modal-banidos", true);
        }

        function closeBanidos() { setModalVisivel("modal-banidos", false); }

        function renderizarListaBanidos() {
            const lista = document.getElementById("lista-banidos");
            if (!lista) return;
            const banidos = carregarBanidos();
            if (!banidos.length) {
                lista.innerHTML = `<p class="text-xs text-[var(--muted)] text-center py-4">Nenhum usuário banido no momento.</p>`;
                return;
            }
            lista.innerHTML = banidos.map(b => {
                const nome = sanitizarNomePublico(b.nome || "Usuário");
                const email = b.email ? `<span class="block text-[10px] text-[var(--muted)]">${escapeHtml(b.email)}</span>` : "";
                return `<div class="flex justify-between items-center gap-2 bg-[#14110c] border border-[#26211a] rounded-xl px-3 py-2.5"><div class="min-w-0"><p class="text-xs font-bold text-white truncate">${escapeHtml(nome)}</p>${email}</div><button type="button" onclick="desbanirUsuarioPainel('${escapeHtml(b.nome || "")}')" class="bg-amber-500/10 text-amber-400 px-2.5 py-1 rounded-lg text-xs font-bold cursor-pointer whitespace-nowrap">Desbanir</button></div>`;
            }).join("");
        }

        async function desbanirUsuarioPainel(nome) {
            if (!isAdminUsuario()) return;
            const nomeLimpo = sanitizarNomePublico(nome);
            if (!confirm(`Desbanir o usuário "${nomeLimpo}"? Os anúncios dele voltam ao catálogo quando recarregar.`)) return;
            salvarBanidos(carregarBanidos().filter(b => (b.nome || "").toLowerCase() !== nomeLimpo.toLowerCase()));
            if (window.supabaseClient) {
                try {
                    await window.supabaseClient.from("usuarios_banidos").delete().eq("nome", nomeLimpo);
                } catch (e) {}
            }
            renderizarListaBanidos();
            carregarCatalogo();
            mostrarAlerta("Admin", `Usuário "${nomeLimpo}" desbanido.`);
        }

        async function alternarBanimentoVendedorSelecionado() {
            if (!anuncioSelecionadoAtual) return;
            const btnBan = document.getElementById("btn-banir-detalhes");
            const acao = btnBan && btnBan.dataset.acao === "desbanir" ? "desbanir" : "banir";
            const id = anuncioSelecionadoAtual.id;
            const estaAberto = document.getElementById("modal-detalhes").style.display === "flex";
            if (estaAberto) closeDetalhes();
            await alternarBanimentoVendedor(acao, id);
            if (estaAberto && anunciosEmMemoria.some(a => String(a.id) === String(id))) {
                abrirDetalhes(id);
            }
        }

        async function removerAnuncio(id) {
            const alvo = anunciosEmMemoria.find(a => String(a.id) === String(id));
            anunciosEmMemoria = anunciosEmMemoria.filter(a => String(a.id) !== String(id));
            localStorage.setItem("marktplace_stand2_anuncios", JSON.stringify(anunciosEmMemoria));
            carregarCatalogo();
            const idBanco = alvo && ehIdNumerico(alvo.id) ? Number(alvo.id) : (ehIdNumerico(id) ? Number(id) : null);
            if (window.supabaseClient && idBanco !== null) {
                try {
                    const { error } = await window.supabaseClient.from("contas").delete().eq("id", idBanco);
                    if (error) {}
                } catch (e) {}
            }
        }

        function abrirDetalhes(id) {
            const encontrado = anunciosEmMemoria.find(a => String(a.id) === String(id));
            if (!encontrado) return;
            anuncioSelecionadoAtual = normalizarAnuncio(encontrado);
            document.getElementById("detalhe-titulo").textContent = anuncioSelecionadoAtual.titulo;
            document.getElementById("detalhe-preco").textContent = anuncioSelecionadoAtual.preco;
            document.getElementById("detalhe-badge").textContent = anuncioSelecionadoAtual.rank;
            document.getElementById("detalhe-vinculo").textContent = anuncioSelecionadoAtual.vinculo;
            document.getElementById("detalhe-desc").textContent = anuncioSelecionadoAtual.descricao ?? anuncioSelecionadoAtual.desc;
            document.getElementById("detalhe-vendedor").textContent = sanitizarNomePublico(anuncioSelecionadoAtual.vendedor);
            const imgContainer = document.getElementById("detalhe-img-container");
            const imgElement = document.getElementById("detalhe-imagem");
            const minis = document.getElementById("detalhe-miniaturas");
            minis.innerHTML = "";
            if (anuncioSelecionadoAtual.fotos && anuncioSelecionadoAtual.fotos.length > 0) {
                imgElement.src = anuncioSelecionadoAtual.fotos[0];
                imgContainer.classList.remove("hidden");
                anuncioSelecionadoAtual.fotos.forEach((url, idx) => {
                    const thumb = document.createElement("img");
                    thumb.src = url;
                    thumb.alt = `Miniatura ${idx + 1}`;
                    thumb.className = `w-12 h-12 object-cover rounded cursor-pointer border-2 ${idx === 0 ? "border-[var(--accent)]" : "border-transparent"}`;
                    thumb.onclick = () => { imgElement.src = url; };
                    minis.appendChild(thumb);
                });
            } else {
                imgContainer.classList.add("hidden");
            }
            const acoesAdmin = document.getElementById("detalhes-acoes-admin");
            if (acoesAdmin) {
                if (isAdminUsuario()) {
                    acoesAdmin.classList.remove("hidden");
                    const btnBan = document.getElementById("btn-banir-detalhes");
                    if (btnBan) {
                        const vendedorBanido = usuarioEstaBanido(sanitizarNomePublico(anuncioSelecionadoAtual.vendedor), "");
                        btnBan.textContent = vendedorBanido ? "♻️ Desbanir Vendedor" : "🚫 Banir Vendedor";
                        btnBan.dataset.acao = vendedorBanido ? "desbanir" : "banir";
                    }
                } else {
                    acoesAdmin.classList.add("hidden");
                }
            }
            document.getElementById("modal-detalhes").style.display = "flex";
        }

        function closeDetalhes() { setModalVisivel("modal-detalhes", false); }

        function gerarQrCodePagamento() {
            closeCheckout();
            let totalCarrinhoStr = "R$ 0,00";
            let nomesContas = carrinhoItens.map(i => i.titulo).join(", ");
            if (!nomesContas && anuncioSelecionadoAtual) nomesContas = anuncioSelecionadoAtual.titulo;
            let somaTotal = 0;
            carrinhoItens.forEach(item => {
                let p = parseFloat(item.preco.replace("R$", "").replace(".", "").replace(",", ".").trim()) || 0;
                somaTotal += p;
            });
            if (somaTotal === 0 && anuncioSelecionadoAtual) {
                somaTotal = parseFloat(anuncioSelecionadoAtual.preco.replace("R$", "").replace(".", "").replace(",", ".").trim()) || 0;
            }
            totalCarrinhoStr = `R$ ${somaTotal.toFixed(2).replace(".", ",")}`;
            const metodoEscolhido = document.querySelector('input[name="pagamento"]:checked').value;
            document.getElementById("pedido-codigo").textContent = `Pedido #SO2-${Math.floor(1000 + Math.random() * 9000)}`;
            document.getElementById("pag-conta-nome").textContent = nomesContas || "Conta Standoff 2";
            document.getElementById("pag-conta-valor").textContent = totalCarrinhoStr;
            const conteudoPag = document.getElementById("pag-conteudo");
            if (metodoEscolhido === "pix") {
                const pixStr = `00020126580014br.gov.bcb.pix0136so2-${Date.now()}5204000053039865802BR5913SAFE6009SP62070503***6304`;
                conteudoPag.innerHTML = `<img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(pixStr)}" alt="QR Code PIX" class="mx-auto bg-white p-1 rounded mb-2"><p class="text-[11px] text-gray-400">Escaneie o QR Code ou use o PIX Copia e Cola.</p>`;
            } else {
                conteudoPag.innerHTML = `<div class="py-4 text-emerald-400 font-bold text-sm">💳 Cartão de Crédito Autorizado com Sucesso!</div><p class="text-[11px] text-gray-400">Clique abaixo para gerar o seu ticket e liberar os dados de acesso.</p>`;
            }
            document.getElementById("modal-pagamento-detalhes").style.display = "flex";
        }

        function closePagamentoDetalhes() { document.getElementById("modal-pagamento-detalhes").style.display = "none"; }

        async function enviarComprovanteParaTicket() {
            closePagamentoDetalhes();
            const ticketIdGerado = "TICK-" + Math.floor(10000 + Math.random() * 90000);
            const pedidoIdGerado = "SO2-" + Math.floor(1000 + Math.random() * 9000);
            const metodoRadios = document.querySelectorAll('input[name="pagamento"]');
            let metodoValor = "pix";
            metodoRadios.forEach(r => { if (r.checked) metodoValor = r.value; });
            const metodoPagamento = metodoValor === "cartao" ? "Cartão de Crédito" : "PIX";
            document.getElementById("ticket-id").textContent = `Ticket #${ticketIdGerado}`;
            const destaqueCodigo = document.getElementById("ticket-codigo-destaque-valor");
            if (destaqueCodigo) destaqueCodigo.textContent = ticketIdGerado;
            let gmailUser = currentUser ? currentUser.email : "cliente@gmail.com";
            let wppUser = currentUser ? currentUser.whatsapp : "(Não informado)";
            document.getElementById("ticket-info-gmail").textContent = gmailUser;
            document.getElementById("ticket-info-wpp").textContent = wppUser;
            let nomesItens = carrinhoItens.map(i => i.titulo) || [];
            const listaItensFormatada = Array.isArray(nomesItens)
                ? nomesItens.filter(Boolean).join(", ")
                : String(nomesItens || "").trim();
            let valorTotalPedido = document.getElementById("pag-conta-valor").textContent;
            pedidosAtivos.unshift({
                ticketId: ticketIdGerado,
                pedidoId: pedidoIdGerado,
                comprador: gmailUser,
                status: "Aprovado • Custódia Segura",
                itens: listaItensFormatada,
                total: valorTotalPedido,
                etapasCustodia: [ETAPAS_CUSTODIA[0]]
            });
            localStorage.setItem("marktplace_stand2_pedidos", JSON.stringify(pedidosAtivos));
            await salvarTicketSupabase({
                codigo: ticketIdGerado,
                comprador_email: String(gmailUser || "").toLowerCase() === "cliente@gmail.com" ? "" : String(gmailUser || "").toLowerCase(),
                comprador_nome: currentUser ? sanitizarNomePublico(currentUser.username) : "Visitante",
                comprador_whatsapp: wppUser || "",
                itens: listaItensFormatada || "",
                valor_total: valorTotalPedido || "",
                metodo_pagamento: metodoPagamento,
                etapa: 1,
                status_texto: "Pagamento retido pelo site (custódia segura)",
                concluido: false
            });
            const statusKey = "aguardando_conta_vendedor";
            const resumoRapido = montarResumoRapidoTicket({
                ticketId: ticketIdGerado,
                statusKey,
                itensResumo: listaItensFormatada || "Item do catálogo",
                compradorEmail: gmailUser,
                compradorWhats: wppUser
            });
            const chatBox = document.getElementById("chat-mensagens");
            chatBox.innerHTML += `<div class="bg-[#050505] border border-[#26211a] rounded-xl p-3 text-gray-300 max-w-[90%] space-y-1"><p class="font-bold text-[var(--accent)]">🤖 Bot de Entrega Automática</p><p class="text-[11px] text-emerald-400 font-semibold">✓ Pagamento e Comprovante Aprovados!</p>${resumoRapido}</div>`;
            chatBox.scrollTop = chatBox.scrollHeight;
            document.getElementById("modal-ticket").style.display = "flex";
            carrinhoItens = [];
            localStorage.removeItem("marktplace_stand2_cart");
            atualizarBadgeCarrinho();
        }

        function closeTicketModal() { document.getElementById("modal-ticket").style.display = "none"; }

        function abrirChatSuporte() {
            closeTicketModal();
            document.getElementById("modal-chat-suporte").style.display = "flex";
            const chatMenu = document.getElementById("chat-mensagens");
            if (chatMenu && !chatMenu.querySelector("[data-menu-bot]")) {
                chatMenu.innerHTML += construirMenuBot().replace('<div class="bg-[#050505] border border-[#26211a] rounded-xl p-2.5 max-w-[90%]"', '<div data-menu-bot class="bg-[#050505] border border-[#26211a] rounded-xl p-2.5 max-w-[90%]"');
                chatMenu.scrollTop = chatMenu.scrollHeight;
            }
        }

        function closeChatSuporte() { document.getElementById("modal-chat-suporte").style.display = "none"; }

        function classificarAssuntoSuporte(texto) {
            const t = (texto || "").toLowerCase();
            if (!t) return null;
            const ticketNaMensagem = (texto.match(/TICK-\d+/i) || [""])[0].toUpperCase();
            const ticketSessao = (!ticketNaMensagem && Array.isArray(pedidosAtivos) && pedidosAtivos[0]) ? String(pedidosAtivos[0].ticketId).toUpperCase() : "";
            const ticket = ticketNaMensagem || ticketSessao;
            const regras = [
                ["suporte_humano", /suporte|atendimento|atendente|falar com (o |a |algu|equipe)/],
                ["pagamento", /pagamento|comprovante|cobran|pix|cart[aã]o|estorn|reembols|devolu|refund/],
                ["entrega_rastreio", /entrega|entregue|dados da conta|recebi a conta|rastrei|ticket|tick-\d+|TICK-\d|status do (meu )?pedido/],
                ["acesso_conta", /login|logar|entrar na conta|senha|c[oó]digo|banido|banimento|bloquead|den[uú]ncia|denunciar|golpe|suspeita|fraude|hacker/]
            ];
            for (const [assunto, re] of regras) {
                if (re.test(t)) return { assunto: assunto, ticket: ticket };
            }
            return null;
        }

        function registrarDisparoWhatsApp(assunto) {
            const agora = Date.now();
            let registros = {};
            try { registros = JSON.parse(sessionStorage.getItem(CHAVE_STORAGE_WPP_COOLDOWN) || "{}"); } catch (e) { registros = {}; }
            if (typeof registros !== "object" || registros === null) registros = {};
            const ultimo = Number(registros[assunto] || 0);
            if (agora - ultimo < WHATSAPP_ALERTA_COOLDOWN_MS) return false;
            registros[assunto] = agora;
            sessionStorage.setItem(CHAVE_STORAGE_WPP_COOLDOWN, JSON.stringify(registros));
            return true;
        }

        function montarMensagemAlertaWhatsApp(assunto, ticket, mensagem) {
            const origem = "MARKTPLACE stand2 (Suporte)";
            const usuario = currentUser ? `${sanitizarNomePublico(currentUser.username)} (${currentUser.email})` : "Visitante";
            return [
                `[ALERTA] ${origem}`,
                `Usuario: ${usuario}`,
                `Ticket: ${ticket || "(nenhum)"}`,
                `Assunto: ${assunto}`,
                `Mensagem: ${mensagem}`
            ].join("\n");
        }

        function dispararAlertaWhatsAppAdmin(assunto, ticket, mensagem) {
            if (!ADMIN_WHATSAPP) return false;
            if (!registrarDisparoWhatsApp(assunto)) return false;
            const url = "https://wa.me/" + ADMIN_WHATSAPP + "?text=" + encodeURIComponent(montarMensagemAlertaWhatsApp(assunto, ticket, mensagem));
            const chat = document.getElementById("chat-mensagens");
            if (chat) {
                chat.innerHTML += `<div class="bg-[#050505] border border-[#2f2920] rounded-xl p-2.5 text-gray-300 max-w-[90%]"><p class="font-bold text-[var(--accent)]">Bot Oficial</p>O suporte intermediário foi acionado. Toque abaixo para avisar o admin no WhatsApp:<a href="${url}" target="_blank" rel="noopener" class="block text-center mt-2 py-2 rounded-xl text-xs font-bold bg-[var(--accent)] text-black no-underline">📲 Acionar Suporte no WhatsApp</a></div>`;
                chat.scrollTop = chat.scrollHeight;
            }
            return true;
        }

        const OPCOES_MENU_BOT = [
            { numero: 1, rotulo: "Rastrear pedido / Ticket", resposta: "Digite o codigo do seu ticket (ex: TICK-12345) aqui no chat ou use o menu 'Rastrear Pedido' para consultar o status e as etapas de custodia." },
            { numero: 2, rotulo: "Intermediacao / custodia", resposta: "A custodia funciona assim: o pagamento fica retido pelo site e liberado ao vendedor somente apos a entrega confirmada da conta. Sem chat direto entre comprador e vendedor." },
            { numero: 3, rotulo: "Duvidas de pagamento", resposta: "Comprovantes, cobrancas e estornos sao tratados pelo admin manualmente. Se o pagamento ja foi feito, acione o suporte no WhatsApp que o admin recebe um alerta." },
            { numero: 4, rotulo: "Anunciar conta", resposta: "Use o menu 'Anunciar Conta': faca login, envie os prints do inventario (o site le os itens automaticamente), preencha titulo e preco e publique." },
            { numero: 5, rotulo: "Login / codigo Gmail / conta", resposta: "O codigo de verificacao chega por Gmail (EmailJS). Nao recebeu? Verifique o spam ou acione o suporte no WhatsApp pelo chat." },
            { numero: 6, rotulo: "Suporte oficial", resposta: "Acionando o suporte oficial: o admin foi avisado no WhatsApp. Toque no botao acima ou descreva melhor o problema aqui no chat." }
        ];

        function construirMenuBot() {
            const Itens = OPCOES_MENU_BOT.map(o => `<button type="button" onclick="escolherOpcaoBot(${o.numero}, '${escapeHtml(o.rotulo)}')" class="block w-full text-left text-left bg-[#1c1812] hover:bg-[#26211a] border border-[#2f2920] rounded-xl px-3 py-2 text-white cursor-pointer"><span class="text-[var(--accent)] font-bold">${o.numero}.</span> ${escapeHtml(o.rotulo)}</button>`).join("");
            return `<div class="bg-[#050505] border border-[#26211a] rounded-xl p-2.5 max-w-[90%]"><p class="font-bold text-[var(--accent)] mb-1.5">Bot Oficial</p><p class="text-gray-300 mb-2">Como posso ajudar? Escolha uma opcao ou digite sua mensagem:</p><div class="space-y-1.5">${Itens}</div></div>`;
        }

        function escolherOpcaoBot(numero, rotulo) {
            const chat = document.getElementById("chat-mensagens");
            if (!chat) return;
            const opcao = OPCOES_MENU_BOT.find(o => o.numero === numero);
            const textoUsuario = `${numero}. ${rotulo}`;
            chat.innerHTML += `<div class="bg-[#1c1812] border border-[#2f2920] rounded-xl p-2.5 text-white ml-auto max-w-[85%] text-right"><p class="font-bold text-[var(--accent)]">Você</p>${escapeHtml(textoUsuario)}</div>`;
            chat.scrollTop = chat.scrollHeight;
            const classificacao = (!isAdminUsuario()) ? classificarAssuntoSuporte(rotulo) : null;
            if (classificacao) { setTimeout(() => dispararAlertaWhatsAppAdmin(classificacao.assunto, classificacao.ticket, textoUsuario), 200); }
            setTimeout(async () => {
                let respostaFinal;
                if (opcao && opcao.numero === 1) {
                    try { respostaFinal = await respostaOpcaoRastrear(); } catch (e) { respostaFinal = opcao.resposta; }
                } else {
                    respostaFinal = (opcao ? opcao.resposta : "");
                }
                chat.innerHTML += `<div class="bg-[#050505] border border-[#26211a] rounded-xl p-2.5 text-gray-300 max-w-[85%] whitespace-pre-line"><p class="font-bold text-[var(--accent)]">Bot Oficial</p>${escapeHtml(respostaFinal)}</div>`;
                chat.scrollTop = chat.scrollHeight;
            }, 600);
        }

        function normalizarCodigoTicket(texto) {
            return String(texto || "").toUpperCase().replace(/[^A-Z0-9-]/g, "");
        }

        async function salvarTicketSupabase(registro) {
            if (!window.supabaseClient || !registro || !registro.codigo) return false;
            try {
                const { error } = await window.supabaseClient.from("tickets").insert([registro]);
                if (error) { return false; }
                return true;
            } catch (e) {
                return false;
            }
        }

        function converterRegistroSupabase(row) {
            const etapa = Math.min(5, Math.max(1, Number(row.etapa) || 1));
            return {
                ticketId: String(row.codigo || "").toUpperCase(),
                pedidoId: String(row.codigo || "").toUpperCase(),
                comprador: row.comprador_email || "",
                nome: row.comprador_nome || "",
                whatsapp: row.comprador_whatsapp || "",
                metodo: row.metodo_pagamento || "",
                criadoEm: row.created_at || null,
                status: row.status_texto || ETAPAS_CUSTODIA[etapa - 1],
                itens: row.itens || "",
                total: row.valor_total != null ? String(row.valor_total) : "",
                etapa: etapa,
                concluido: Boolean(row.concluido),
                concluidoEm: row.concluido_em || null,
                etapasCustodia: ETAPAS_CUSTODIA.slice(0, etapa)
            };
        }

        function sincronizarPedidoLocal(pedido) {
            if (!pedido || !pedido.ticketId) return pedido;
            const codigo = normalizarCodigoTicket(pedido.ticketId);
            if (!Array.isArray(pedidosAtivos)) pedidosAtivos = [];
            const indice = pedidosAtivos.findIndex(p => normalizarCodigoTicket((p && (p.ticketId || p.pedidoId))) === codigo);
            if (indice >= 0) { pedidosAtivos[indice] = pedido; } else { pedidosAtivos.unshift(pedido); }
            try { localStorage.setItem("marktplace_stand2_pedidos", JSON.stringify(pedidosAtivos)); } catch (e) {}
            return pedido;
        }

        async function buscarTicketSupabase(codigo) {
            if (!window.supabaseClient || !codigo) return null;
            try {
                const { data, error } = await window.supabaseClient.from("tickets").select("*").eq("codigo", codigo).maybeSingle();
                if (error || !data) return null;
                return data;
            } catch (e) {
                return null;
            }
        }

        async function ticketsAtivosSupabase(email) {
            if (!window.supabaseClient || !email) return null;
            try {
                const { data, error } = await window.supabaseClient.from("tickets").select("*").eq("comprador_email", String(email).toLowerCase()).eq("concluido", false);
                if (error || !Array.isArray(data)) return null;
                return data.map(converterRegistroSupabase);
            } catch (e) {
                return null;
            }
        }

        async function atualizarEtapaTicketSupabase(codigo, etapa, statusTexto, concluido) {
            if (!window.supabaseClient || !codigo) return false;
            try {
                const { data, error } = await window.supabaseClient.from("tickets").update({ etapa: etapa, status_texto: statusTexto, concluido: concluido, concluido_em: concluido ? new Date().toISOString() : null }).eq("codigo", codigo).select("codigo");
                if (error || !Array.isArray(data) || data.length === 0) return false;
                return true;
            } catch (e) {
                return false;
            }
        }

        function ticketConcluido(pedido) {
            const status = String((pedido && pedido.status) || "").toLowerCase();
            return /(conclu|entregue|encerrad)/.test(status);
        }

        function ticketPertenceAoUsuario(pedido) {
            if (!pedido || !pedido.comprador || !currentUser || !currentUser.email) return true;
            return String(pedido.comprador).toLowerCase() === String(currentUser.email).toLowerCase();
        }

        function ticketsAtivosDoUsuario() {
            return (Array.isArray(pedidosAtivos) ? pedidosAtivos : []).filter(p => p && p.ticketId && !ticketConcluido(p) && ticketPertenceAoUsuario(p));
        }

        async function respostaOpcaoRastrear() {
            let lista;
            const remotos = (currentUser && currentUser.email && window.supabaseClient)
                ? await ticketsAtivosSupabase(currentUser.email)
                : null;
            if (Array.isArray(remotos)) {
                lista = remotos;
            } else {
                lista = ticketsAtivosDoUsuario();
            }
            if (!lista.length) {
                return "Nenhum ticket ativo encontrado para você nesta sessão. Se você já comprou antes, digite aqui o código do seu ticket (ex: TICK-4819) para consultá-lo, use o menu 'Rastrear Pedido', ou acione o Suporte oficial pelo WhatsApp. Tickets concluídos aparecem apenas consultando o código exato.";
            }
            const linhas = lista.slice(0, 8).map(p => `• ${String(p.ticketId).toUpperCase()} — ${p.status || "em custódia"}`).join("\n");
            return `Você tem ${lista.length} ticket(s) ativo(s):\n${linhas}\n\nPara acompanhar: menu 'Rastrear Pedido' e digite o código TICK-, ou fale com o Suporte oficial pelo WhatsApp. Tickets concluídos saem desta lista e ficam consultáveis pelo código exato.`;
        }

        function respostaBotPorPalavraChave(texto) {
            const t = (texto || "").toLowerCase();
            if (/rastr|ticket|tick-\d|t-i-c-k|pedido/.test(t)) return respostaOpcaoRastrear();
            if (/cust[oó]dia|intermedi|segur|transfer/.test(t)) return OPCOES_MENU_BOT[1].resposta;
            if (/pag|comprov|pix|cobran|estorn|reembols/.test(t)) return OPCOES_MENU_BOT[2].resposta;
            if (/anunci|vender|publicar|invent/.test(t)) return OPCOES_MENU_BOT[3].resposta;
            if (/login|logar|senha|c[oó]digo|gmail|email/.test(t)) return OPCOES_MENU_BOT[4].resposta;
            if (/suporte|atendente|humano|falar/.test(t)) return OPCOES_MENU_BOT[5].resposta;
            if (/ol[aá]|oi|bom dia|boa tarde|boa noite|obrigad|teste/.test(t)) return "Olá! Sou o bot do MARKTPLACE stand2. Escolha uma opção abaixo para receber ajuda:";
            return null;
        }

        function enviarMensagemSuporte() {
            const input = document.getElementById("chat-input-texto");
            if (!input.value.trim()) return;
            const textoUsuario = input.value.trim();
            const chat = document.getElementById("chat-mensagens");
            chat.innerHTML += `<div class="bg-[#1c1812] border border-[#2f2920] rounded-xl p-2.5 text-white ml-auto max-w-[85%] text-right"><p class="font-bold text-[var(--accent)]">Você</p>${escapeHtml(textoUsuario)}</div>`;
            input.value = "";
            chat.scrollTop = chat.scrollHeight;
            const classificacao = (!isAdminUsuario()) ? classificarAssuntoSuporte(textoUsuario) : null;
            const disparouWhatsApp = classificacao ? dispararAlertaWhatsAppAdmin(classificacao.assunto, classificacao.ticket, textoUsuario) : false;
            const respostaPalavra = respostaBotPorPalavraChave(textoUsuario);
            setTimeout(async () => {
                if (disparouWhatsApp) return;
                let textoFinal = null;
                try { textoFinal = await respostaPalavra; } catch (e) { textoFinal = null; }
                if (textoFinal && String(textoFinal).includes("Escolha uma opção")) {
                    chat.innerHTML += construirMenuBot();
                } else if (textoFinal) {
                    chat.innerHTML += `<div class="bg-[#050505] border border-[#26211a] rounded-xl p-2.5 text-gray-300 max-w-[85%] whitespace-pre-line"><p class="font-bold text-[var(--accent)]">Bot Oficial</p>${escapeHtml(textoFinal)}</div>`;
                } else {
                    chat.innerHTML += construirMenuBot();
                }
                chat.scrollTop = chat.scrollHeight;
            }, 1000);
        }

        function openModalComoFunciona() { setModalVisivel("modal-como-funcionamos", true); }
        function closeModalComoFunciona() { setModalVisivel("modal-como-funcionamos", false); }

        (function() {
            const header = document.querySelector("header.sticky");
            if (!header) return;
            let lastScrollY = window.scrollY;
            const hideThreshold = 80;
            const showMinDelta = 20;
            const showNearTop = 120;
            const updateHeader = () => {
                const currentScrollY = window.scrollY;
                const scrollDelta = lastScrollY - currentScrollY;
                if (currentScrollY > hideThreshold && currentScrollY > lastScrollY) {
                    header.style.transform = "translateY(-100%)";
                    header.style.opacity = "0";
                } else if (scrollDelta > showMinDelta && currentScrollY < showNearTop) {
                    header.style.transform = "translateY(0)";
                    header.style.opacity = "1";
                }
                lastScrollY = currentScrollY <= 0 ? 0 : currentScrollY;
            };
            let ticking = false;
            window.addEventListener("scroll", () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        updateHeader();
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
            updateHeader();
        })();
    </script>

</body>
</html>