<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Standoff 2 - Catálogo e Contas</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0a0a0f;
      --bg-subtle: #12121a;
      --card: #1a1a24;
      --card-hover: #222230;
      --fg: #f0f0f5;
      --muted: #8888a0;
      --accent: #c8102e;
      --accent-hover: #e71534;
      --border: #2a2a3a;
      --success: #10b981;
      --info: #3b82f6;
      --warning: #f59e0b;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
      overflow-x: hidden;
    }

    .bg-pattern {
      background-image: 
        linear-gradient(180deg, rgba(20,20,30,0.3) 1px, transparent 1px),
        linear-gradient(90deg, rgba(20,20,30,0.3) 1px, transparent 1px);
      background-size: 50px 50px;
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

    .hamburger {
      width: 32px; height: 32px; cursor: pointer; transition: transform 0.3s ease;
    }
    .hamburger.active { transform: rotate(45deg); }
    .hamburger span {
      display: block; width: 100%; height: 2px; background: var(--fg);
      margin: 8px 0; transition: all 0.3s ease;
    }
    .hamburger.active span:nth-child(1) { opacity: 0; transform: translateX(8px); }
    .hamburger.active span:nth-child(2) { transform: rotate(90deg); }
    .hamburger.active span:nth-child(3) { opacity: 0; transform: translateX(-8px); }

    .mobile-menu {
      position: fixed; top: 0; right: 0; width: 300px; max-height: 100vh;
      background: var(--bg-subtle); border-left: 1px solid var(--border);
      transform: translateX(100%); transition: transform 0.3s ease; z-index: 250;
    }
    .mobile-menu.open { transform: translateX(0); }
    .mobile-menu a {
      display: block; padding: 1rem 1.5rem; color: var(--fg); text-decoration: none;
      border-bottom: 1px solid var(--border); transition: background 0.2s;
    }
    .mobile-menu a:hover { background: var(--card); }

    .accounts-grid {
      display: grid; gap: 1.5rem; grid-template-columns: 1fr;
      @media (min-width: 640px) { grid-template-columns: repeat(2, 1fr); }
      @media (min-width: 1024px) { grid-template-columns: repeat(3, 1fr); }
      @media (min-width: 1280px) { grid-template-columns: repeat(4, 1fr); }
    }

    .account-card {
      background: var(--card); border: 1px solid var(--border); border-radius: 12px;
      overflow: hidden; transition: transform 0.2s, box-shadow 0.2s;
    }
    .account-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
    .account-card img { width: 100%; height: 180px; object-fit: cover; transition: transform 0.3s; }
    .account-card:hover img { transform: scale(1.05); }
    .card-content { padding: 1.25rem; }
    .card-title { font-size: 1.125rem; font-weight: 500; margin-bottom: 0.25rem; }
    .card-meta { font-size: 0.875rem; color: var(--muted); margin-bottom: 0.75rem; }
    .card-desc {
      font-size: 0.875rem; color: var(--muted); line-height: 1.4;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    .site-footer { background: var(--bg-subtle); border-top: 1px solid var(--border); }

    a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    @media (prefers-reduced-motion: reduce) {
      .hamburger span { transition: none; }
      .account-card:hover { transform: none; }
    }

    /* Modal Login/Registro */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center; z-index: 200;
      opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s;
    }
    .modal-overlay.open { opacity: 1; visibility: visible; }
    .modal-box {
      background: var(--card); border: 1px solid var(--border); border-radius: 16px;
      width: 90%; max-width: 400px; max-height: 90vh; transform: scale(0.9) translateY(20px);
      transition: transform 0.3s cubic-bezier(0.16,1,0.3,1);
      overflow-y: auto;
    }
    .modal-overlay.open .modal-box { transform: scale(1) translateY(0); }
    .modal-header { padding: 1.5rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .modal-title { font-size: 1.25rem; font-weight: 600; }
    .modal-close {
      width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;
      background: transparent; cursor: pointer; padding: 0;
      color: var(--muted);
      font-size: 1.5rem;
      transition: color 0.2s;
    }
    .modal-close:hover { color: var(--fg); }
    .tab-buttons { padding: 0.5rem 1.5rem; display: flex; border-bottom: 1px solid var(--border); }
    .tab-btn { flex: 1; padding: 0.75rem; border-radius: 8px 8px 0 0; border: 1px solid transparent; color: var(--muted); font-weight: 500; cursor; transition: all 0.2s; background: transparent; }
    .tab-btn.active { color: var(--accent); border-color: var(--accent); background: var(--card-hover); }
    .tab-content { padding: 1.5rem; display: none; }
    .tab-content.active { display: block; }
    .input-group { margin-bottom: 1.25rem; }
    .input-group label { display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; }
    .input-group input {
      width: 100%; padding: 0.75rem 1rem; background: var(--bg); border: 1px solid var(--border);
      border-radius: 8px; color: var(--fg); font-family: 'Inter', sans-serif; font-size: 1rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .input-group input:focus {
      outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(200,16,46,0.15);
    }
    .input-group input::placeholder { color: var(--muted); }
    .btn-primary {
      width: 100%; padding: 0.875rem; background: var(--accent); color: white;
      border: none; border-radius: 8px; font-weight: 600; font-size: 1rem;
      cursor: pointer; transition: background 0.2s; margin-top: 0.5rem;
    }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-secondary {
      width: 100%; padding: 0.875rem; background: transparent; color: var(--fg);
      border: 1px solid var(--border); border-radius: 8px; font-weight: 500; font-size: 1rem;
      cursor: pointer; transition: all 0.2s; margin-top: 0.5rem;
    }
    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
    .divider { height: 1px; background: var(--border); margin: 1rem 0; position: relative; }
    .divider::after { content: 'ou'; position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); background: var(--card); padding: 0 0.5rem; font-size: 0.875rem; }
    .link-small { font-size: 0.875rem; color: var(--muted); text-align: center; margin-top: 1rem; }
    .link-small a { color: var(--accent); text-decoration: none; transition: color 0.2s; }
    .link-small a:hover { color: var(--accent-hover); }

    /* Animations */
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in-up { animation: fadeInUp 0.4s cubic-bezier(0.16,1,0.3,1) forwards; }
  </style>
</head>
<body class="bg-pattern">

  <!-- Header com Menu Hambúrguer -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-[var(--bg)]/80 backdrop-blur-md border-b border-[var(--border)]">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="text-xl font-bold text-[var(--accent)]">Standoff 2</span>
        <span class="text-sm text-[var(--muted)]">Catálogo</span>
      </div>
      <button class="hamburger hamburger--spin" id="hamburgerBtn" aria-label="Abrir menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <nav class="mobile-menu" id="mobileMenu" aria-label="Navegação principal">
      <a href="#secao-contas" class="block">Contas</a>
      <a href="#features" class="block">Features</a>
      <a href="#sobre" class="block">Sobre</a>
      <a href="#anunciar" class="block">+ Anunciar Conta</a>
      <a href="#" class="block">Sair</a>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="min-h-screen flex items-center justify-center px-6 pt-20">
    <div class="max-w-4xl text-center">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-4">
        Explore o melhor <span class="text-[var(--accent)]">Standoff 2</span>
      </h1>
      <p class="text-lg md:text-xl text-[var(--muted)] max-w-2xl mx-auto">
        Descubra contas exclusivas, skins raras e equipamentos premium para elevar sua experiência no jogo.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#secao-contas" class="btn-primary px-6">Ver Catálogo</a>
        <button class="btn-secondary open-modal">Entrar / Cadastrar</button>
        <button class="btn-termo open-modal termo-btn">Termos de Uso</button>
        <button class="btn-anuncio open-modal">Anunciar Conta</button>
      </div>
    </div>
  </section>

  <!-- Modal Anunciar Conta -->
  <div class="modal-overlay" id="modalAnuncio">
    <div class="modal-box animate-fade-in-up">
      <div class="modal-header">
        <h2 class="modal-title">Anunciar Conta</h2>
        <button class="modal-close absolute top-2 right-2 text-[var(--muted)] hover:text-[var(--fg)] transition" aria-label="Fechar modal" onclick="closeModalAnuncio()">×</button>
      </div>
      <div class="modal-content">
        <form onsubmit="handleAnuncio(event)">
          <div class="input-group"><label>Nome da Conta</label><input type="text" required placeholder="Ex: Conta Lendária Rank 5" autocomplete="name"></div>
          <div class="input-group"><label>Rank/Nível</label><input type="text" required placeholder="Ex: Diamante, Master, Lendário" autocomplete="username"></div>
          <div class="input-group prefixed-input">
              <span class="prefix">R$</span>
              <input type="number" id="precoAnuncio" required placeholder="0,00" min="0" step="5" class="price-input">
            </div>
          <div class="input-group"><label>Descrição</label><textarea rows="3" required placeholder="Descreva as skins, estatísticas e diferenciais da conta"></textarea></div>
          <p class="text-[var(--muted)] text-sm mt-2">⚠️ <strong>AVISO:</strong> Negociações realizadas por fora da plataforma não possuem suporte e resultam em <strong>banimento permanente</strong>.</p>
          <button type="submit" class="btn-primary w-full mt-4">Publicar Anúncio</button>
          <p class="text-center text-[var(--muted)] text-sm mt-4">Anúncios são revisados em até 24h. O site não se responsabiliza por transações fora da plataforma.</p>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeModalAnuncio()">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Modal de Termos -->
  <div class="modal-overlay" id="modalTermos">
    <div class="modal-box animate-fade-in-up">
      <div class="modal-header">
        <h2 class="modal-title">Termos de Uso e Isenção de Responsabilidade</h2>
        <button class="modal-close absolute top-2 right-2 text-[var(--muted)] hover:text-[var(--fg)] transition" aria-label="Fechar modal" onclick="closeModalTermos()">×</button>
      </div>
      <div class="modal-content">
        <h3>1. Aceite destes Termos</h3>
        <p>Ao acessar e usar este catálogo de contas para Standoff 2, você concorda em ficar vinculado a estes Termos de Uso. Estes termos se aplicam a todos os visitantes, usuários e outros que acessem o site. Este site é uma plataforma independente e não tem qualquer afiliação ou vínculo oficial com a Axlebolt Ltd ou com o jogo Standoff 2.</p>
        
        <h3>2. Isenção de Responsabilidade</h3>
        <p>Este site fornece informações sobre contas de Standoff 2 apenas para fins informativos. Não somos afiliados, associados, autorizados ou de alguma forma oficialmente conectados com a empresa desenvolvedora de Standoff 2 ou com a Axlebolt Ltd. Todas as marcas, nomes registrados e imagens pertencem aos seus respectivos proprietários e são usados apenas para fins de identificação.</p>
        
        <h3>3. Limitação de Responsabilidade</h3>
        <p>Em nenhum evento este site ou seus proprietários serão responsáveis por quaisquer danos diretos, indiretos, incidentais, especiais, consequenciais ou quaisquer danos de qualquer tipo, sejam eles decorrentes de perda de lucros, dados ou lucros cessantes, seja em uma ação de contrato, danos extracontratuais ou de outra natureza, decorrentes do uso ou da incapacidade de usar os serviços deste site.</p>
        
        <h3>4. Precificação e Disponibilidade</h3>
        <p>Os preços das contas estão sujeitos a alterações sem aviso prévio. A disponibilidade de contas é limitada e pode ser removida a qualquer momento. Não garantimos a disponibilidade contínua do site ou dos serviços.</p>
        
        <h3>6. Conta do Usuário</h3>
        <p>Você é responsável por manter a segurança da sua conta e senha. Você concorda por ser responsável por todas as atividades que ocorrem sob sua conta. Use estas contas por sua conta e risco. Ao utilizar ou negociar contas deste site, o usuário assume total responsabilidade por qualquer penalidade, banimento ou violação dos Termos de Serviço oficiais da Axlebolt Ltd decorrente do uso ou negociação de contas. Este site não se responsabiliza por consequências decorrentes do uso indevido das contas listadas aqui.</p>

        <h3>8. Aviso Importante</h3>
        <p>Negociações realizadas por fora da plataforma não possuem suporte e resultam em <strong>banimento permanente</strong>. Para proteger seus dados e conta, todas as transações devem ocorrer exclusivamente através do sistema centralizado deste site.</p>
        
        <h3>7. Conteúdo de Terceiros</h3>
        <p>Pode conter links para conteúdo de terceiros que não são propiedad ou controlado por este site. Não temos controle sobre, e assumimos nenhuma responsabilidade pelo conteúdo, políticas de privacidade ou práticas de quaisquer sites ou serviços de terceiros.</p>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeModalTermos()">Concordo e Continuar</button>
      </div>
    </div>
  </div>

  <!-- Contas Grid -->
  <section id="secao-contas" class="max-w-7xl mx-auto px-6 pb-12">
    <h2 class="text-3xl font-semibold mb-8">Catálogo de Contas</h2>
    <p class="text-[var(--muted)] mb-8">Selecione uma conta abaixo:</p>
    <div class="accounts-grid">
      <article class="account-card"><img src="https://images.unsplash.com/photo-1566546626024-1c31655e5f7e?w=500&h=300&fit=crop" alt="Conta Lendária" loading="lazy"><div class="card-content"><h3 class="card-title">Conta Lendária</h3><p class="card-meta">Rank lendário • 500+ vitórias</p><p class="card-desc">Conta com as skins mais exclusivas do jogo e estatísticas excepcionais. Pronto para competição.</p></div></article>
      <article class="account-card"><img src="https://images.unsplash.com/photo-1571003123494-1f059892a1be?w=500&h=300&fit=crop" alt="Conta Competitive" loading="lazy"><div class="card-content"><h3 class="card-title">Conta Competitive</h3><p class="card-meta">Rank Diamond • 200+ vitórias</p><p class="card-desc">Conta bem balanceada com equipamentos de alto desempenho. Ideal para subir de rank.</p></div></article>
      <article class="account-card"><img src="https://images.unsplash.com/photo-1518717758534-8338861e72c1?w=500&h=300&fit=crop" alt="Conta Collection" loading="lazy"><div class="card-content"><h3 class="card-title">Conta Collection</h3><p class="card-meta">Colecionador • 300+ skins</p><p class="card-desc">Acumule uma vasta coleção de skins e itens raros. O sonho de qualquer colecionador.</p></div></article>
      <article class="account-card"><img src="https://images.unsplash.com/photo-1565665031411-7b07523d1a5e?w=500&h=300&fit=crop" alt="Conta Elite" loading="lazy"><div class="card-content"><h3 class="card-title">Conta Elite</h3><p class="card-meta">Rank Master • 100+ vitórias</p><p class="card-desc">Conta elite com acesso antecipado a novas funcionalidades e eventos exclusivos.</p></div></article>
      <article class="account-card"><img src="https://images.unsplash.com/photo-1518769573014-8547901f79ec?w=500&h=300&fit=crop" alt="Conta Iniciante" loading="lazy"><div class="card-content"><h3 class="card-title">Conta Iniciante</h3><p class="card-meta">Rank Bronze • 50+ vitórias</p><p class="card-desc">Pontapé inicial perfeito. Conta com itens básicos para aprender o jogo.</p></div></article>
      <article class="account-card"><img src="https://images.unsplash.com/photo-1566546626024-1c31655e5f7e?w=500&h=300&fit=crop" alt="Conta Premium" loading="lazy"><div class="card-content"><h3 class="card-title">Conta Premium</h3><p class="card-meta">Rank Platinum • 350+ vitórias</p><p class="card-desc">Conta premium com todas as vantagens e bônus exclusivos disponíveis.</p></div></article>
      <article class="account-card"><img src="https://images.unsplash.com/photo-1571003123494-1f059892a1be?w=500&h=300&fit=crop" alt="Conta Mítica" loading="lazy"><div class="card-content"><h3 class="card-title">Conta Mítica</h3><p class="card-meta">Rank Mythic • 50+ vitórias</p><p class="card-desc">A conta mais rara do catálogo. Acesso limitado a itens lendários e efeitos exclusivos.</p></div></article>
      <article class="account-card"><img src="https://images.unsplash.com/photo-1518717758534-8338861e72c1?w=500&h=300&fit=crop" alt="Conta Special" loading="lazy"><div class="card-content"><h3 class="card-title">Conta Special</h3><p class="card-meta">Edição Limitada • 100+ vitórias</p><p class="card-desc">Conta de edição limitada com itens que nunca mais serão disponibilizados.</p></div></article>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="max-w-7xl mx-auto px-6 mb-12">
    <h2 class="text-3xl font-semibold mb-6">Por que escolher nossa conta?</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div><div class="w-12 h-12 rounded-full bg-[var(--accent)]/20 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><stroke-width>2</stroke><path d="M12 14l9-5a1 1 0 000-1.72l-9-5a1 1 0 00-1.72 1L2 14a1 1 0 00.34 1.31l8 4a1 1 0 001.66 0l8-4a1 1 0 00.34-1.31L12 14z"/></svg></div><h3 class="font-medium mb-2">Segurança garantida</h3><p class="text-[var(--muted)]">Todas as contas passam por verificação rigorosa de segurança e autenticidade.</p></div>
      <div><div class="w-12 h-12 rounded-full bg-[var(--info)]/20 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-[var(--info)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><stroke-width>2</stroke><path d="M12 6v6l4 2v6H6v-6l4-2z"/><path d="M12 18v6l4 2v-6h-2v6l-4 2v-6H4v-6l4-2z"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="18" r="1"/></svg></div><h3 class="font-medium mb-2">Suporte 24h</h3><p class="text-[var(--muted)]">Equipe de suporte pronta para ajudar a qualquer hora do dia.</p></div>
      <div><div class="w-12 h-12 rounded-full bg-[var(--success)]/20 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-[var(--success)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><stroke-width>2</stroke><path d="M12 19v-4m0-7v4m6-3h4a2 2 0 002-2V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m2 6H15"/><path d="M9.683 7H4a2 2 0 00-2 2v2a2 2 0 002 2h2.683l5.25 4.75a2 2 0 01-.391 3.07L21 12a2 2 0 01-2.058 1.38L13 19.5l1.75 2.25a2 2 0 01-.39 3.07l-5.25 4.75A2 2 0 0021 17v-2a2 2 0 00-2-2h-2.683l-5.25-4.75a2 2 0 01-.391-3.07L3 12a2 2 0 00-2.058-1.38L11 4.5l-1.75-2.25a2 2 0 01.391-3.07l5.25-4.75z"/></svg></div><h3 class="font-medium mb-2">Entrega rápida</h3><p class="text-[var(--muted)]">Sua conta é entregue em até 24h após a confirmação do pagamento.</p></div>
      <div><div class="w-12 h-12 rounded-full bg-purple-500/20 flex items-center justify-center mb-4"><svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><stroke-width>2</stroke><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H4a2 2 0 00-2 2v6a2 2 0 002 2z"/><path d="M2 4h20a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2V4a2 2 0 012-2z"/></svg></div><h3 class="font-medium mb-2">Privacidade total</h3><p class="text-[var(--muted)]">Suas informações permanecem confidenciais e nunca são compartilhadas.</p></div>
    </div>
  </section>

  <!-- Sobre -->
  <section id="sobre" class="max-w-7xl mx-auto px-6 mb-12">
    <h2 class="text-3xl font-semibold mb-6">Sobre o Standoff 2</h2>
    <p class="text-[var(--muted)] leading-relaxed">
      Standoff 2 é a versão mobile do popular jogo de tiro tático Counter-Strike. Com jogabilidade fluida, mapas icônicos e uma comunidade vibrante, o jogo oferece uma experiência completa de tiro tático para dispositivos móveis (iOS e Android). Nosso catálogo traz as melhores contas para você aproveitar ao máximo todo o potencial do jogo.
    </p>
  </section>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div>
          <h4 class="font-medium mb-3">Standoff 2</h4>
          <p class="text-[var(--muted)] text-sm">Catálogo oficial de contas para Standoff 2. Seguro, rápido e confiável.</p>
          <div class="mt-4">
            <a href="#" class="text-[var(--muted)] hover:text-[var(--fg)] transition text-sm" onclick="openTermosModal()">Termos de Uso e Isenção</a>
            <span class="mx-2 text-[var(--muted)] hover:text-[var(--fg)] transition">|</span>
            <a href="#" class="text-[var(--muted)] hover:text-[var(--fg)] transition text-sm">Termos de uso</a>
            <span class="mx-2 text-[var(--muted)] hover:text-[var(--fg)] transition">|</span>
            <a href="#" class="text-[var(--muted)] hover:text-[var(--fg)] transition text-sm">Política de privacidade</a>
          </div>
        </div>
        <div>
          <h4 class="font-medium mb-3">Produto</h4>
          <ul class="space-y-2 text-[var(--muted)] text-sm">
            <li><a href="#secao-contas">Catálogo de contas</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#sobre">Sobre</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-medium mb-3">Recursos</h4>
          <ul class="space-y-2 text-[var(--muted)] text-sm">
            <li><a href="#" class="hover:text-[var(--fg)] transition">Suporte</a></li>
            <li><a href="#" class="hover:text-[var(--fg)] transition">FAQ</a></li>
            <li><a href="#" class="hover:text-[var(--fg)] transition">Contato</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-medium mb-3">Siga-nos</h4>
          <div class="flex gap-3">
            <a href="#" class="w-8 h-8 rounded-full bg-[var(--border)] flex items-center justify-center text-[var(--muted)] hover:text-[var(--fg)] transition"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><stroke-width>2</stroke><path d="M12 6v6l4 2v6h-6V8a2 2 0 012-2h2a2 2 0 012 2v6h-6l4 2z"/></svg></a>
            <a href="#" class="w-8 h-8 rounded-full bg-[var(--border)] flex items-center justify-center text-[var(--muted)] hover:text-[var(--fg)] transition"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><stroke-width>2</stroke><path d="M12 6v6l4 2v6h-6V8a2 2 0 012-2h2a2 2 0 012 2v6h-6l4 2z"/></svg></a>
            <a href="#" class="w-8 h-8 rounded-full bg-[var(--border)] flex items-center justify-center text-[var(--muted)] hover:text-[var(--fg)] transition"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><stroke-width>2</stroke><path d="M12 6v6l4 2v6h-6V8a2 2 0 012-2h2a2 2 0 012 2v6h-6l4 2z"/></svg></a>
          </div>
        </div>
      </div>
      <div class="mt-8 pt-8 border-t border-[var(--border)] text-center">
        <p class="text-[var(--muted)] text-sm">2024 Standoff 2 Catalog. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>

  <!-- Modal Login/Registro -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-box animate-fade-in-up">
      <div class="modal-header">
        <h2 class="modal-title">Acesso à Conta</h2>
        <button class="modal-close" aria-label="Fechar modal" onclick="closeModal()">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><stroke-width>2</stroke><path d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="tab-buttons">
        <button class="tab-btn active" onclick="showTab('login')">Entrar</button>
        <button class="tab-btn" onclick="showTab('register')">Cadastrar</button>
      </div>
      
      <!-- Login Tab -->
      <div id="tab-login" class="tab-content active">
        <form onsubmit="handleLogin(event)">
          <div class="input-group"><label>Email</label><input type="email" required placeholder="seu@email.com" autocomplete="email"></div>
          <div class="input-group"><label>Senha</label><input type="password" required placeholder="••••••••" autocomplete="current-password"></div>
          <button type="submit" class="btn-primary w-full mt-4">Entrar na Conta</button>
          <p class="link-small">Não tem uma conta? <a onclick="showTab('register')" style="color: var(--accent)">Cadastrar</a></p>
        </form>
      </div>

      <!-- Register Tab -->
      <div id="tab-register" class="tab-content">
        <form onsubmit="handleRegister(event)">
          <div class="input-group"><label>Nome Completo</label><input type="text" required placeholder="Seu Nome" autocomplete="name"></div>
          <div class="input-group"><label>Email</label><input type="email" required placeholder="seu@email.com" autocomplete="email"></div>
          <div class="input-group"><label>Senha</label><input type="password" required placeholder="••••••••" autocomplete="new-password"></div>
          <div class="input-group"><label>Confirmar Senha</label><input type="password" required placeholder="••••••••" autocomplete="new-password"></div>
          <button type="submit" class="btn-primary w-full mt-4">Criar Conta</button>
          <p class="link-small">Já tem uma conta? <a onclick="showTab('login')" style="color: var(--accent)">Entrar</a></p>
        </form>
      </div>

      <div class="divider"></div>
      <p class="text-center text-[var(--muted)] text-sm">Ao cadastrar, você concorda com nossos <a href="#" class="underline text-[var(--accent)]">Termos de Serviço</a> e <a href="#" class="underline text-[var(--accent)]">Política de Privacidade</a></p>
    </div>
  </div>

  <script>
    // Hamburger Menu
    document.addEventListener('DOMContentLoaded', function() {
      const hamburgerBtn = document.getElementById('hamburgerBtn');
      const mobileMenu = document.getElementById('mobileMenu');

      hamburgerBtn.addEventListener('click', function() {
        this.classList.toggle('active');
        mobileMenu.classList.toggle('open');
        this.setAttribute('aria-expanded', this.classList.contains('active'));
        mobileMenu.setAttribute('aria-hidden', !this.classList.contains('active'));
      });

      const menuLinks = mobileMenu.querySelectorAll('a');
      menuLinks.forEach(link => {
        link.addEventListener('click', function() {
          hamburgerBtn.classList.remove('active');
          mobileMenu.classList.remove('open');
          hamburgerBtn.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
        });
      });

      document.addEventListener('click', function(event) {
        if (!hamburgerBtn.contains(event.target) && !mobileMenu.contains(event.target)) {
          hamburgerBtn.classList.remove('active');
          mobileMenu.classList.remove('open');
          hamburgerBtn.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
        }
      });

      let touchStartX = 0; let touchEndX = 0;
      mobileMenu.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
      mobileMenu.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        const swipeThreshold = 50;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > swipeThreshold) {
          hamburgerBtn.classList.remove('active');
          mobileMenu.classList.remove('open');
          hamburgerBtn.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
        }
      });

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        hamburgerBtn.style.transition = 'none';
      }
    });

    // Modal Logic
    const modalOverlay = document.getElementById('modalOverlay');

    function openModal() {
      modalOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modalOverlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    function closeModalTermos() {
      const modalTermos = document.getElementById('modalTermos');
      if (modalTermos) {
        modalTermos.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    function closeModalAnuncio() {
      const modalAnuncio = document.getElementById('modalAnuncio');
      if (modalAnuncio) {
        modalAnuncio.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    function openTermosModal() {
      const modalTermos = document.getElementById('modalTermos');
      if (modalTermos) {
        modalTermos.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }
    }

    function showTab(tabName) {
      // Hide all tab contents
      document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
      // Hide all tab buttons
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      // Show selected tab content
      document.getElementById('tab-' + tabName).classList.add('active');
      // Activate selected tab button
      event.currentTarget.classList.add('active');
    }

    function handleLogin(event) {
      event.preventDefault();
      // Simulate login
      alert('Login realizado com sucesso!');
      closeModal();
    }

    function handleRegister(event) {
      event.preventDefault();
      // Simple validation
      const senha = event.target.querySelector('input[type="password"]:nth-of-type(1)').value;
      const confirmSenha = event.target.querySelector('input[type="password"]:nth-of-type(2)').value;
      if (senha !== confirmSenha) {
        alert('As senhas não coincidem!');
        return;
      }
      alert('Conta criada com sucesso!');
      closeModal();
    }

    // Close modal on overlay click
    modalOverlay.addEventListener('click', function(e) {
      if (e.target === modalOverlay) closeModal();
    });

    // Open modal on load (optional - commented)
    // openModal();

    // Check for persisted user on page load
    document.addEventListener('DOMContentLoaded', function() {
      const storedUser = localStorage.getItem('standoff2_user');
      if (storedUser) {
        showUserLoggedIn(JSON.parse(storedUser));
      }
    });

    // Persist user session with LocalStorage
    function persistUser(userData) {
      localStorage.setItem('standoff2_user', JSON.stringify(userData));
    }

    function getStoredUser() {
      const storedUser = localStorage.getItem('standoff2_user');
      return storedUser ? JSON.parse(storedUser) : null;
    }

    // Show user as logged in UI update
    function showUserLoggedIn(user) {
      // Update header to show logged in state
      const headerCTA = document.querySelector('.open-modal');
      if (headerCTA) {
        headerCTA.innerHTML = `
          <span class="text-sm font-medium text-[var(--fg)]">Bem-vindo, ${user.nome}</span>
        `;
        headerCTA.onclick = function() {
          closeModal();
          // Reset to login form
          showTab('login');
        };
      }
      // Hide modal after auto-login
      setTimeout(closeModal, 500);
    }

    // Handle Login with LocalStorage persistence
    function handleLogin(event) {
      event.preventDefault();
      const email = event.target.querySelector('input[type="email"]').value;
      const senha = event.target.querySelector('input[type="password"]').value;
      const storedUser = getStoredUser();
      
      // Verify both email and password match stored data
      if (storedUser && storedUser.email === email && storedUser.senha === senha) {
        alert('Login bem-sucedido! Bem-vindo de volta, ' + storedUser.nome + '!');
        persistUser(storedUser); // Keep session
        showUserLoggedIn(storedUser);
        closeModal();
      } else {
        alert('Email ou senha inválidos. Por favor, cadastre-se ou verifique suas credenciais.');
        // Show register tab as alternative
        showTab('register');
      }
    }

    // Handle Registration with LocalStorage persistence
    function handleRegister(event) {
      event.preventDefault();
      const nome = event.target.querySelector('input[placeholder="Seu Nome"]').value;
      const email = event.target.querySelector('input[type="email"]').value;
      const senha = event.target.querySelector('input[type="password"]:nth-of-type(1)').value;
      const confirmSenha = event.target.querySelector('input[type="password"]:nth-of-type(2)').value;
      
      if (senha !== confirmSenha) {
        alert('As senhas não coincidem!');
        return;
      }
      
      // Save user to LocalStorage
      const userData = { nome, email, senha }; // Store actual password (demo purposes)
      persistUser(userData);
      
      alert('Conta criada com sucesso! Você já pode fazer login.');
      closeModal();
      // Auto-show login tab after registration
      showTab('login');
    }

    function handleAnuncio(event) {
      event.preventDefault();
      const nomeConta = event.target.querySelector('input[type="text"]').value;
      const rank = event.target.querySelector('input[type="text"]:nth-of-type(2)').value;
      const precoInput = event.target.querySelector('.price-input');
      const preco = precoInput ? precoInput.value : '0';
      const descricao = event.target.querySelector('textarea').value;
      
      if (!nomeConta || !rank || !preco) {
        alert('Por favor, preencha todos os campos!');
        return;
      }
      
      alert('Anúncio publicado com sucesso! Sua conta está visível no catálogo.');
      closeModalAnuncio();
    }

    // Close modal on overlay click
    modalOverlay.addEventListener('click', function(e) {
      if (e.target === modalOverlay) closeModal();
    });

    // Keyboard accessibility - Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modalOverlay.classList.contains('open')) {
        closeModal();
      }
    });

    // Logic for Termos modal
    const termoBtn = document.querySelector('.termo-btn');
    const modalTermos = document.getElementById('modalTermos');
    if (termoBtn && modalTermos) {
      termoBtn.addEventListener('click', function() {
        modalTermos.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
      // Close on overlay click
      modalTermos.addEventListener('click', function(e) {
        if (e.target === modalTermos) {
          closeModalTermos();
        }
      });
    }

    // Logic for Novo Anúncio modal
    const anuncioBtn = document.querySelector('.open-modal[onclick*="Anunciar"]');
    const modalAnuncio = document.getElementById('modalNovoAnuncio');
    const formNovoAnuncio = document.getElementById('formNovoAnuncio');
    
    if (anuncioBtn && modalAnuncio) {
      anuncioBtn.addEventListener('click', function() {
        modalAnuncio.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
      // Close on overlay click
      modalAnuncio.addEventListener('click', function(e) {
        if (e.target === modalAnuncio) {
          closeModalNovoAnuncio();
        }
      });
    }
    
    // Handle form submission for new announcement
    formNovoAnuncio.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Get form data
      const fileInput = formNovoAnuncio.querySelector('input[type="file"]');
      const titleInput = formNovoAnuncio.querySelector('input[placeholder*="Conta"]') || 
                        formNovoAnuncio.querySelector('input[type="text"]');
      const rankInput = formNovoAnuncio.querySelector('input[placeholder*="Rank"]') || 
                       formNovoAnuncio.querySelector('input[type="text"]:nth-of-type(2)');
      const priceInput = formNovoAnuncio.querySelector('input[placeholder*="R$"]') || 
                        formNovoAnuncio.querySelector('input[placeholder*="€"]') || 
                        formNovoAnuncio.querySelector('input[type="number"]');
      const contactInput = formNovoAnuncio.querySelector('input[placeholder*="WhatsApp"]') || 
                          formNovoAnuncio.querySelector('input[placeholder*="Discord"]') || 
                          formNovoAnuncio.querySelector('input[type="text"]:last-child');
      const descInput = formNovoAnuncio.querySelector('textarea');
      
      // Preview image with FileReader
      if (fileInput && fileInput.files && fileInput.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const preview = formNovoAnuncio.querySelector('.anuncio-preview');
          if (preview) {
            preview.innerHTML = `<img src="${e.target.result}" alt="Preview da conta" class="w-full h-48 object-cover rounded-tlg">`;
          }
        };
        reader.readAsDataURL(fileInput.files[0]);
      }
      
      // Collect form data
      const novoAnuncio = {
        id: Date.now(),
        titulo: titleInput ? titleInput.value : 'Conta Sem Título',
        rank: rankInput ? rankInput.value : 'Rank Unknown',
        preco: priceInput ? priceInput.value : '0',
        moeda: priceInput && priceInput.placeholder.includes('€') ? '€' : 'R$',
        contato: contactInput ? contactInput.value : 'Não informado',
        descricao: descInput ? descInput.value : 'Sem descrição',
        dataCriacao: new Date().toLocaleDateString('pt-BR'),
        visualizacoes: 0
      };
      
      // Save to LocalStorage
      let anuncios = JSON.parse(localStorage.getItem('anuncios')) || [];
      anuncios.push(novoAnuncio);
      localStorage.setItem('anuncios', JSON.stringify(anuncios));
      
      // Render new card in the grid
      renderAnuncioCard(novoAnuncio);
      
      // Show success message and close modal
      alert('Anúncio publicado com sucesso! Sua conta está visível no catálogo.');
      closeModalNovoAnuncio();
    });

    // Render annuncio card in the grid
    function renderAnuncioCard(anuncio) {
      const grid = document.querySelector('.accounts-grid');
      if (!grid) return;
      
      // Formata o preço em Reais com duas casas decimais
      const precoFormatado = new Intl.NumberFormat('pt-BR', {minimumFractionDigits: 2, maximumFractionDigits: 2}).format(Number(anuncio.preco));
      const precoDisplay = 'R$ ' + precoFormatado;
      
      // Define a cor baseada no preço (verde para acima de 100, vermelho para abaixo)
      const corPreco = Number(anuncio.preco) >= 100 ? 'text-green-500' : 'text-red-500';
      
      const card = document.createElement('article');
      card.className = 'account-card';
      card.innerHTML = `
        <img src="${anuncio.fotoPrincipal ? anuncio.fotoPrincipal : 'https://images.unsplash.com/photo-1566546626024-1c31655e5f7e?w=500&h=300&fit=crop'" alt="${anuncio.titulo}" loading="lazy" class="w-100 h-48 object-cover rounded-tlg">
        <div class="card-content">
          <h3 class="card-title">${anuncio.titulo}</h3>
          <p class="card-meta">${anuncio.rank} • <span class="${corPreco}">${precoDisplay}</span></p>
          <p class="card-desc">${anuncio.descricao.substring(0, 100)}...</p>
        </div>
        <div class="card-actions">
          <button class="btn-sucesso w-full" onclick="openPaymentModal()">Comprar via Intermediário (Garantido)</button>
        </div>
      `;
      
      // Insert at the beginning of the grid
      grid.insertBefore(card, grid.firstChild);
    }

    function closeModalNovoAnuncio() {

    function openPaymentModal() {
      const modalPagamento = document.getElementById("modalPagamento");
      if (modalPagamento) {
        modalPagamento.classList.add("open");
        document.body.style.overflow = "hidden";
      }
    }


    function closeModalPagamento() {
      const modalPagamento = document.getElementById("modalPagamento");
      if (modalPagamento) {
        modalPagamento.classList.remove("open");
        document.body.style.overflow = "";
      }
    }
      const modalAnuncio = document.getElementById('modalNovoAnuncio');
      if (modalAnuncio) {
        modalAnuncio.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    // Close modal on overlay click
    modalOverlay.addEventListener('click', function(e) {
      if (e.target === modalOverlay) closeModal();
    });

    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modalOverlay.classList.contains('open')) {
        closeModal();
      }
      if (e.key === 'Escape' && modalTermos.classList.contains('open')) {
        closeModalTermos();
      }
      if (e.key === 'Escape' && modalAnuncio.classList.contains('open')) {
        closeModalNovoAnuncio();
      }
    });
  <!-- Modal Novo Anúncio -->
  <div class="modal-overlay" id="modalNovoAnuncio">
    <div class="modal-box animate-fade-in-up">
      <div class="modal-header">
        <h2 class="modal-title">Novo Anúncio</h2>
        <button class="modal-close absolute top-2 right-2 text-[var(--muted)] hover:text-[var(--fg)] transition" aria-label="Fechar modal" onclick="closeModalNovoAnuncio()">×</button>
      </div>
      <div class="modal-content">
        <form id="formNovoAnuncio" onsubmit="return false;">
          <div class="grid grid-cols-1 gap-4 mb-4">
            <div>
              <label class="block text-sm text-[var(--muted)] mb-2">Foto da Conta</label>
              <input type="file" accept="image/*" class="w-full rounded border p-2 file-input" id="fotoConta">
              <div class="anuncio-preview mt-2" style="border: 1px dashed var(--border); border-radius: 8px; height: 150px; display: flex; align-items: center; justify-content: center; color: var(--muted);"></div>
            </div>
            <div>
              <label class="block text-sm text-[var(--muted)] mb-2">Título da Conta</label>
              <input type="text" placeholder="Ex: Conta com Faca M9" required class="w-full rounded border p-2">
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm text-[var(--muted)] mb-2">Rank e Nível / Vitórias</label>
                <input type="text" placeholder="Ex: Rank Master • 300 vitórias" required class="w-full rounded border p-2">
              </div>
              <div>
                <label class="block text-sm text-[var(--muted)] mb-2">Preço</label>
                <div class="grid grid-cols-2 gap-2">
                  <input type="number" placeholder="150" required class="w-full rounded border p-2">
                  <select class="w-full rounded border p-2">
                    <option value="R$">R$</option>
                    <option value="€">€</option>
                    <option value="US$">US$</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
            <div class="input-group mb-4">
              <label class="block text-sm text-[var(--muted)] mb-2">Link ou Número de Contato</label>
              <input type="text" placeholder="Ex: WhatsApp +55 11 98888-7777 ou Discord#1234" required class="w-full rounded border p-2">
            </div>
            <div class="input-group mb-4">
              <label class="block text-sm text-[var(--muted)] mb-2">Descrição e Destaques</label>
              <textarea rows="4" placeholder="Skins principais: Faca M9, AK-47 | Redline. Luvas: Falchion. Medalhas: Veterano. Vínculo: Compartilhado" required class="w-full rounded border p-2 resize-none"></textarea>
            </div>
          </div>
          <p class="text-[var(--muted)] text-sm mt-2">⚠️ <strong>AVISO:</strong> Negociações realizadas por fora da plataforma não possuem suporte e resultam em <strong>banimento permanente</strong>.</p>
          <div class="modal-actions">
            <button type="submit" class="btn-primary w-full">Publicar Anúncio</button>
            <button type="button" class="btn-secondary w-full" onclick="closeModalNovoAnuncio()">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
// Logic for Termos modal
    const termoBtn = document.querySelector('.termo-btn');
    const modalTermos = document.getElementById('modalTermos');
    if (termoBtn && modalTermos) {
      termoBtn.addEventListener('click', function() {
        modalTermos.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
      // Close on overlay click
      modalTermos.addEventListener('click', function(e) {
        if (e.target === modalTermos) {
          closeModalTermos();
        }
      });
    }

    // Logic for Novo Anúncio modal
    const anuncioBtn = document.querySelector('.open-modal[onclick*="Anunciar"]');
    const modalAnuncio = document.getElementById('modalNovoAnuncio');
    const formNovoAnuncio = document.getElementById('formNovoAnuncio');
    
    if (anuncioBtn && modalAnuncio) {
      anuncioBtn.addEventListener('click', function() {
        modalAnuncio.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
      // Close on overlay click
      modalAnuncio.addEventListener('click', function(e) {
        if (e.target === modalAnuncio) {
          closeModalNovoAnuncio();
        }
      });
    }
    
    // Handle form submission for new announcement
    formNovoAnuncio.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Get form data
      const fileInput = formNovoAnuncio.querySelector('input[type="file"]');
      const titleInput = formNovoAnuncio.querySelector('input[placeholder*="Conta"]') || 
                        formNovoAnuncio.querySelector('input[type="text"]');
      const rankInput = formNovoAnuncio.querySelector('input[placeholder*="Rank"]') || 
                       formNovoAnuncio.querySelector('input[type="text"]:nth-of-type(2)');
      const priceInput = formNovoAnuncio.querySelector('input[placeholder*="R$"]') || 
                        formNovoAnuncio.querySelector('input[placeholder*="€"]') || 
                        formNovoAnuncio.querySelector('input[type="number"]');
      const contactInput = formNovoAnuncio.querySelector('input[placeholder*="WhatsApp"]') || 
                          formNovoAnuncio.querySelector('input[placeholder*="Discord"]') || 
                          formNovoAnuncio.querySelector('input[type="text"]:last-child');
      const descInput = formNovoAnuncio.querySelector('textarea');
      
      // Preview image with FileReader
      if (fileInput && fileInput.files && fileInput.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const preview = formNovoAnuncio.querySelector('.anuncio-preview');
          if (preview) {
            preview.innerHTML = `<img src="${e.target.result}" alt="Preview da conta" class="w-full h-48 object-cover rounded-tlg">`;
          }
        };
        reader.readAsDataURL(fileInput.files[0]);
      }
      
      // Collect form data
      const novoAnuncio = {
        id: Date.now(),
        titulo: titleInput ? titleInput.value : 'Conta Sem Título',
        rank: rankInput ? rankInput.value : 'Rank Unknown',
        preco: priceInput ? priceInput.value : '0',
        moeda: priceInput && priceInput.placeholder.includes('€') ? '€' : 'R$',
        contato: contactInput ? contactInput.value : 'Não informado',
        descricao: descInput ? descInput.value : 'Sem descrição',
        dataCriacao: new Date().toLocaleDateString('pt-BR'),
        visualizacoes: 0
      };
      
      // Save to LocalStorage
      let anuncios = JSON.parse(localStorage.getItem('anuncios')) || [];
      anuncios.push(novoAnuncio);
      localStorage.setItem('anuncios', JSON.stringify(anuncios));
      
      // Render new card in the grid
      renderAnuncioCard(novoAnuncio);
      
      // Show success message and close modal
      alert('Anúncio publicado com sucesso! Sua conta está visível no catálogo.');
      closeModalNovoAnuncio();
    });

    // Render annuncio card in the grid
    function renderAnuncioCard(anuncio) {
      const grid = document.querySelector('.accounts-grid');
      if (!grid) return;
      
      const card = document.createElement('article');
      card.className = 'account-card';
      card.innerHTML = `
        <img src="${anuncio.fotoPrincipal ? anuncio.fotoPrincipal : 'https://images.unsplash.com/photo-1566546626024-1c31655e5f7e?w=500&h=300&fit=crop'}" alt="${anuncio.titulo}" loading="lazy" class="w-100 h-48 object-cover rounded-tlg">
        <div class="card-content">
          <h3 class="card-title">${anuncio.titulo}</h3>
          <p class="card-meta">${anuncio.rank} • ${anuncio.preco}</p>
          <p class="card-desc">${anuncio.descricao.substring(0, 100)}...</p>
        </div>
        <div class="card-actions">
          <button class="btn-sucesso w-full" onclick="openPaymentModal()">Comprar via Intermediário (Garantido)</button>
        </div>
      `;
      
      // Insert at the beginning of the grid
      grid.insertBefore(card, grid.firstChild);
    }

    function closeModalNovoAnuncio() {

    function openPaymentModal() {
      const modalPagamento = document.getElementById("modalPagamento");
      if (modalPagamento) {
        modalPagamento.classList.add("open");
        document.body.style.overflow = "hidden";
      }
    }


    function closeModalPagamento() {
      const modalPagamento = document.getElementById("modalPagamento");
      if (modalPagamento) {
        modalPagamento.classList.remove("open");
        document.body.style.overflow = "";
      }
    }
      const modalAnuncio = document.getElementById('modalNovoAnuncio');
      if (modalAnuncio) {
        modalAnuncio.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    // Close modal on overlay click
    modalOverlay.addEventListener('click', function(e) {
      if (e.target === modalOverlay) closeModal();
    });

    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modalOverlay.classList.contains('open')) {
        closeModal();
      }
      if (e.key === 'Escape' && modalTermos.classList.contains('open')) {
        closeModalTermos();
      }
      if (e.key === 'Escape' && modalAnuncio.classList.contains('open')) {
        closeModalNovoAnuncio();
      }
    });
  <!-- Modal de Pagamento -->
  <div class="modal-overlay" id="modalPagamento">
    <div class="modal-box animate-fade-in-up">
      <div class="modal-header">
        <h2 class="modal-title">Pagamento Centralizado</h2>
        <button class="modal-close absolute top-2 right-2 text-[var(--muted)] hover:text-[var(--fg)] transition" aria-label="Fechar modal" onclick="closeModalPagamento()">×</button>
      </div>
      <div class="modal-content">
        <p class="text-[var(--muted)] text-center mb-8">Pix: chavesite@standoff2.com</p>
        <p class="text-[var(--accent)] text-bold mb-4">Taxa de comissão já inclusa</p>
        <p class="text-[var(--muted)] text-sm mb-8">Ao prosseguir, você concorda com os Termos de Uso e Isenção de Responsabilidade.</p>
        <div class="grid grid-cols-2 gap-4 mb-6">
          <button class="btn-primary w-full">Pagar via Pix (R$ 15,00)</button>
          <button class="btn-secondary w-full" onclick="closeModalPagamento()">Cancelar</button>
        </div>
        <p class="text-[var(--muted)] text-xs text-center">A transação será processada e a conta desbloqueada em até 24h úteis.</div>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" onclick="closeModalPagamento()">Entendido</button>
      </div>
    </div>
  </div>

  <script>
</script>
</body>
</html>
