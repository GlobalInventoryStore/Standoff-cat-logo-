# MARKTPLACE stand2 - chaves de configuracao
# Copie este arquivo para .env, preencha os valores e rode:
#   node scripts/gerar-config.mjs
# Isso gera o config.js que o index.html carrega (config.js e .env NUNCA vao para o git).
# Ou, em vez de arquivo, defina as mesmas variaveis no contêiner / CI (docker -e, GitHub Actions Secrets, etc).

# ===== Supabase (banco do site) =====
# URL do projeto: Painel Supabase > Settings > API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publica (publishable/anon) — pode ficar no HTML, mas prefira injetar: Settings > API > anon / publishable
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# ===== EmailJS (envio de codigos por email) =====
# Painel EmailJS > Dashboard
EMAILJS_SERVICE_ID=service_XXXXXXX
EMAILJS_TEMPLATE_ID=template_XXXXXXX
EMAILJS_PUBLIC_KEY=SuaChavePublicaEmailJS

# ===== Segredos do admin — NUNCA comitar, SEM fallback no codigo =====
# Codigo fixo de verificacao do admin no cadastro/anuncio (6 digitos). Vazio = admin recebe codigo aleatorio por email.
CODIGO_ADMIN_FIXO=111111
# WhatsApp do admin em formato internacional (publico por natureza, mas mantenha aqui p/ trocar sem editar codigo)
ADMIN_WHATSAPP=5561999999999
# Opcional: senha de acesso direto do admin. Vazio = login normal pelo cadastro.
ADMIN_SENHA_DIRETA=
